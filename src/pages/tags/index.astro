---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { ViewTransitions } from 'astro:transitions';

const blog = await getCollection('blog');
const tagsMap: Record<string, number> = {};
blog.forEach(post => {
  post.data.tags.forEach(tag => {
    tagsMap[tag] = (tagsMap[tag] || 0) + 1;
  });
});

const sortedTags = Object.entries(tagsMap).sort((a, b) => b[1] - a[1]);
const maxCount = sortedTags[0]?.[1] || 1;
const minCount = sortedTags[sortedTags.length - 1]?.[1] || 1;
const maxFontSize = 2;
const minFontSize = 0.85;

function getFontSize(count: number): number {
  if (maxCount === minCount) return (maxFontSize + minFontSize) / 2;
  return minFontSize + ((count - minCount) / (maxCount - minCount)) * (maxFontSize - minFontSize);
}

function getColor(count: number): string {
  // 颜色按数量从少到多排列
  // 青 -> 蓝 -> 紫 -> 黄 -> 橙
  const colors = ['#8be9fd', '#9bdbee', '#bd93f9', '#f1fa8c', '#ffb300'];
  const ratio = (count - minCount) / (maxCount - minCount || 1);
  const baseIndex = Math.floor(ratio * (colors.length - 1));
  return colors[baseIndex];
}
---

<Layout title="标签" description="Tags" comments={false}>
  <ViewTransitions />

  <header class="tags-header">
    <h1 class="tags-title">标签</h1>
    <p class="tags-subtitle">共 {sortedTags.length} 个标签</p>
  </header>

  <div class="tags-toolbar">
    <div class="search-box">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input
        type="text"
        id="tag-filter"
        class="search-input"
        placeholder="搜索标签..."
        autocomplete="off"
      />
    </div>
  </div>

  <div class="tag-cloud" data-tag-cloud>
    {sortedTags.map(([tag, count]) => (
      <a
        href={`/tags/${tag}`}
        class="tag-item"
        data-name={tag.toLowerCase()}
        style={`--font-size: ${getFontSize(count)}rem; --tag-color: ${getColor(count)};`}
      >
        <span class="tag-name">#{tag}</span>
        <span class="tag-count">{count}</span>
      </a>
    ))}
    <p class="no-results" data-no-results>没有匹配的标签</p>
  </div>
</Layout>

<script>
  function initTagFilter() {
    const input = document.getElementById('tag-filter') as HTMLInputElement | null;
    const cloud = document.querySelector('[data-tag-cloud]');
    if (!input || !cloud) return;

    const items = Array.from(cloud.querySelectorAll<HTMLElement>('.tag-item'));
    const noResults = cloud.querySelector<HTMLElement>('[data-no-results]');

    function filter() {
      const query = input.value.trim().toLowerCase();
      let visible = 0;

      items.forEach(item => {
        const name = item.dataset.name || '';
        const match = name.includes(query);
        item.style.display = match ? '' : 'none';
        if (match) visible++;
      });

      if (noResults) {
        noResults.style.display = visible === 0 && query ? 'block' : 'none';
      }
    }

    input.addEventListener('input', filter);
    filter();
  }

  initTagFilter();
  document.addEventListener('astro:page-load', initTagFilter);
</script>

<style>
  .tags-header {
    text-align: center;
    padding: 3rem 1rem 2rem;
    border-bottom: 1px solid rgba(133, 133, 168, 0.15);
    margin-bottom: 1.5rem;
  }

  .tags-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--fontc);
    margin: 0 0 0.5rem 0;
    font-family: var(--font-family-base);
  }

  .tags-subtitle {
    font-size: 0.9rem;
    color: var(--gray);
    margin: 0;
    font-family: var(--font-family-mono);
  }

  .tags-toolbar {
    max-width: 900px;
    margin: 0 auto 1rem;
    padding: 0 1rem;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: hsl(var(--card) / 0.6);
    border: 1px solid hsl(var(--primary) / 0.15);
    border-radius: 10px;
    transition: all 0.25s ease;
  }

  .search-box:focus-within {
    background: hsl(var(--card) / 0.8);
    border-color: hsl(var(--primary) / 0.4);
    box-shadow: 0 4px 20px hsl(var(--primary) / 0.1);
  }

  .search-box svg {
    color: var(--gray);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--fontc);
    font-family: var(--font-family-mono);
    font-size: 0.9rem;
  }

  .search-input::placeholder {
    color: var(--gray);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1rem 2rem;
    max-width: 900px;
    margin: 0 auto;
    min-height: 30vh;
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    font-family: var(--font-family-mono);
    font-size: var(--font-size);
    color: var(--tag-color);
    text-decoration: none;
    border-radius: 2rem;
    background: hsl(var(--card) / 0.6);
    border: 1px solid hsl(var(--primary) / 0.15);
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .tag-item:hover {
    transform: scale(1.1) translateY(-2px);
    background: hsl(var(--card) / 0.8);
    border-color: var(--tag-color);
    box-shadow: 0 4px 20px hsl(var(--primary) / 0.1);
  }

  .tag-name {
    font-weight: 500;
  }

  .tag-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.4rem;
    font-size: calc(var(--font-size) * 0.65);
    color: var(--gray);
    background: rgba(133, 133, 168, 0.2);
    border-radius: 1rem;
    transition: all 0.3s ease;
  }

  .tag-item:hover .tag-count {
    background: rgba(155, 219, 238, 0.2);
    color: var(--fontc);
  }

  .no-results {
    display: none;
    width: 100%;
    text-align: center;
    padding: 3rem 1rem;
    color: var(--gray);
    font-family: var(--font-family-mono);
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .tags-header {
      padding: 2rem 1rem 1.5rem;
    }

    .tags-title {
      font-size: 1.5rem;
    }

    .tag-cloud {
      gap: 0.75rem;
      padding: 1rem 0.5rem 1.5rem;
    }

    .tag-item {
      padding: 0.4rem 0.8rem;
    }

    .search-box {
      padding: 0.625rem 0.875rem;
    }
  }
</style>
