---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Categorypage from '../../components/blog/Categorypage.astro';
import { ViewTransitions } from 'astro:transitions';

export async function getStaticPaths() {
    const paths = [];
    const blog = await getCollection('blog');
    const categories = [...new Set([].concat.apply([], blog.map(post => post.data.categories)))];
    const langPaths = categories.map((category) => {
        return {
            params: { category },
        };
    });
    paths.push(...langPaths);

    return paths;
}
---
<Layout comments={false}>
  <ViewTransitions />

  <nav class="cat-back" aria-label="breadcrumb">
    <a href="/categories" class="cat-back__link">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="19" y1="12" x2="5" y2="12"/>
        <polyline points="12 19 5 12 12 5"/>
      </svg>
      <span>返回分类</span>
    </a>
  </nav>

  <Categorypage />
</Layout>

<style>
  .cat-back {
    padding: clamp(1.5rem, 4vw, 2.5rem) 0 0;
  }

  .cat-back__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    color: var(--gray);
    text-decoration: none;
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    border: 1px solid var(--hairline);
    border-radius: 2rem;
    background: transparent;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .cat-back__link svg {
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .cat-back__link:hover {
    color: var(--hc);
    border-color: rgba(125, 211, 252, 0.5);
  }

  .cat-back__link:hover svg {
    transform: translateX(-4px);
  }

  main { max-width: 1100px; }
</style>
</Layout>
