---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Categorypage from '../../components/blog/Categorypage.astro';
import { ViewTransitions } from 'astro:transitions';

export async function getStaticPaths() {

    const paths = [];

    const blog = await getCollection('blog');
    const categories = [...new Set([].concat.apply([], blog.map(post => post.data.categories)))];
    // 为每个标签生成路径对象
    const langPaths = categories.map((category) => {
        return {
            params: { category }, // 使用当前语言变量
        };
    });
    // 将当前语言的路径合并到总路径数组中
    paths.push(...langPaths);
    
    return paths;
}
---
<Layout comments={false}>
  <ViewTransitions />
  
  <div class="page-header">
    <a href="/categories" class="back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"/>
        <polyline points="12 19 5 12 12 5"/>
      </svg>
      返回分类页
    </a>
  </div>

  <Categorypage />
</Layout>

<style>
  .page-header {
    margin-bottom: 2rem;
    padding-top: 1rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    color: var(--gray);
    text-decoration: none;
    font-family: var(--font-family-mono);
    font-size: 0.9rem;
    border: 1px solid rgba(133, 133, 168, 0.2);
    border-radius: 2rem;
    transition: all 0.25s ease;
    background: rgba(40, 42, 53, 0.4);
  }

  .back-link svg {
    transition: transform 0.25s ease;
  }

  .back-link:hover {
    color: var(--hc);
    border-color: var(--hc);
    background: rgba(155, 219, 238, 0.1);
    box-shadow: 0 4px 12px rgba(155, 219, 238, 0.1);
  }

  .back-link:hover svg {
    transform: translateX(-4px);
  }

  main {
    width: 960px;
  }
  
  /* 隐藏原始动画样式 */
  @keyframes scale-up-hor-right {}
  @-webkit-keyframes scale-up-hor-right {}
</style>
</Layout>