---
import { WORK } from '../lib/constants'
import { getWorkExperiences } from '../content/config'
import Layout from '../layouts/Layout.astro'
import { ViewTransitions } from 'astro:transitions'
import Timeline from "../components/ui/timeline"

const experiences = await getWorkExperiences()
---

<Layout title={WORK.TITLE} description={WORK.DESCRIPTION} mainClass="work-main">
  <ViewTransitions />
  <Timeline client:load experiences={experiences}/>
</Layout>

<style>
  @media (min-width: 768px) {
    :global(main.work-main) {
      width: 100%;
      max-width: none;
      padding: 0;
    }

    :global(main.work-main astro-island > div) {
      font-family: 'noto-serif', ui-sans-serif, system-ui, sans-serif;
    }
  }
</style>
