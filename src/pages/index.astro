---
import BaseLayout from '../layouts/BaseLayout.astro'
import IntroCard from '../components/sections/IntroCard.astro'
import AboutMe from '../components/sections/AboutMe.astro'
import LatestPosts from '../components/sections/LatestPosts.astro'
import Now from '../components/sections/Now.astro'
import Card from '../components/Card.astro'
---

<BaseLayout
  title="SanXiaoXing"
  description="SanXiaoXing - Happy everyday"
>
  <div
    slot="loader"
    class="loader flex h-screen w-screen fixed inset-0 z-50 items-center justify-center"
    style="background: var(--bgc);"
  >
    <div class="flex flex-col items-center gap-4">
      <div class="h-8 w-8 rounded-full border-2 border-primary/30 border-t-primary animate-spin" />
      <span class="text-sm text-muted-foreground/50 font-mono">loading...</span>
    </div>
  </div>

  <main
    class="mx-auto w-full max-w-5xl overflow-hidden p-3 sm:p-4 md:p-6"
  >
    <div class="grid gap-3 sm:gap-4 md:grid-cols-3 md:gap-4">
      <IntroCard />
      <LatestPosts />
      <AboutMe />
      <Now />
      <Card href='/blog' colSpan="md:col-span-1" variant="gradient">
        <span class="text-3xl">Blog</span>
      </Card>
      <Card href='/tags' colSpan="md:col-span-1" variant="gradient">
        <span class="text-3xl">Tags</span>
      </Card>
    </div>
    <div class="mt-6 text-center">
      <p class="text-xs text-muted-foreground/30 font-mono">
        © 2023 - {new Date().getFullYear()} · Crafted with ♥️ using
        <a href="https://astro.build/" target="_blank" class="text-primary/40 hover:text-primary/70 transition-colors"> Astro</a>
        by <a href="https://github.com/SanXiaoXing" target="_blank" class="text-primary/40 hover:text-primary/70 transition-colors">SanXiaoXing</a>
      </p>
    </div>

  </main>
</BaseLayout>

<script is:inline>
  import { stagger, spring, timeline } from 'motion';

  function initializeAnimation() {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const loader = document.querySelector('.loader');
    const cards = document.querySelectorAll('.card-animate');

    if (reduceMotion) {
      // reduced-motion:遮罩直接移除,卡片本就可见,不做位移
      if (loader) loader.style.display = 'none';
      return;
    }

    const sequence = [
      ['.loader', { opacity: [1, 0], pointerEvents: 'none' }, { duration: 0.3, easing: 'ease-out' }],
      [
        cards,
        { y: ['40%', '0%'], opacity: [0, 1] },
        {
          at: '-0.05',
          duration: 0.5,
          delay: stagger(0.1),
          easing: spring({ velocity: 100, stiffness: 50, damping: 10 }),
        },
      ],
    ];

    timeline(sequence);
  }

  if (typeof window !== 'undefined') {
    initializeAnimation();
  }
</script>

<script defer src="https://umami-one-pi.vercel.app/script.js" data-website-id="ff2a88e9-b998-415a-962f-6ec825f06679"></script>