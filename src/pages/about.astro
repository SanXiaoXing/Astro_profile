---
import Layout from '../layouts/Layout.astro'
import { getWorkExperiences } from '../content/config'
import { WorkLink } from '../components/work-link'
import AboutInteraction from '../components/AboutInteraction.tsx'

const experiences = await getWorkExperiences()
---

<Layout title="关于我" description="关于 SanXiaoXing 的介绍">
  <article class="about-page">
    <header class="about-header">
      <h1 class="about-title">关于我</h1>
      <p class="about-subtitle">Build. Learn. Reflect. Repeat. · 把想法变成系统，把经验沉淀成知识。</p>
    </header>

    <section class="about-body">
      <div class="about-content">
        <p class="about-paragraph">
          你好，我是 SanXiaoXing。
        </p>
        <p class="about-paragraph">
          我是一名软件开发者，专注于自动化工具、系统设计与工程实践。我相信，技术的价值不仅在于实现功能，更在于不断积累、持续优化，并最终解决真实的问题。
        </p>
        <p class="about-paragraph">
          这个博客记录着我的学习、项目和思考，希望在分享经验的同时，也见证自己的成长。
        </p>
      </div>

      <WorkLink client:load href="/work" enText="Work Experience" experiences={experiences} />
    </section>

    <AboutInteraction client:load />
  </article>
</Layout>

<style>
  .about-page {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .about-header {
    margin: 3.5rem 0 2.5rem;
  }

  .about-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--fontc);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .about-subtitle {
    font-size: 0.875rem;
    color: var(--foreground);
    opacity: 0.6;
    margin-top: 0.5rem;
    letter-spacing: 0.01em;
  }

  .about-body {
    margin-bottom: 5rem;
    display: grid;
    gap: 2.5rem;
  }

  .about-content {
    padding: 2rem;
    background: 
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent),
      rgba(255, 255, 255, 0.01);
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.08));
    border-radius: 1.25rem;
    position: relative;
    overflow: hidden;
  }

  .about-content::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 100%;
    background: linear-gradient(180deg, hsl(var(--primary)), transparent);
    opacity: 0.5;
  }

  .about-paragraph {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--foreground);
    opacity: 0.88;
    margin: 0 0 1.25rem;
    max-width: 65ch;
  }

  .about-paragraph:last-child {
    margin-bottom: 0;
  }

  :global(.about-work) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  :global(.about-work-link) {
    display: grid;
    gap: 1.75rem;
    width: 100%;
    padding: 1.5rem;
    text-decoration: none;
    color: var(--fontc);
    border: 1px solid var(--glass-border, rgba(255,255,255,0.12));
    border-radius: 1.25rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.02)),
      rgba(255, 255, 255, 0.02);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.03),
      0 16px 40px rgba(0, 0, 0, 0.16);
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      background 0.3s ease,
      box-shadow 0.3s ease;
  }

  :global(.about-work-link:hover),
  :global(.about-work-link:focus-visible) {
    border-color: hsl(var(--primary) / 0.3);
    background: hsl(var(--primary) / 0.05);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 22px 48px rgba(0, 0, 0, 0.2);
    transform: translateY(-2px);
  }

  :global(.about-work-link:focus-visible) {
    outline: 2px solid hsl(var(--primary) / 0.35);
    outline-offset: 4px;
  }

  :global(.about-work-head) {
    display: grid;
    gap: 0.75rem;
  }

  :global(.about-work-kicker) {
    font-size: 0.75rem;
    font-family: var(--font-mono, "SFMono-Regular", Consolas, monospace);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: hsl(var(--primary));
    opacity: 0.78;
  }

  :global(.about-work-title-row) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  :global(.about-work-en) {
    display: inline-flex;
    align-items: center;
  }

  :global(.about-work-en-text) {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fontc);
  }

  :global(.about-work-description) {
    margin: 0;
    max-width: 44rem;
    font-size: 0.98rem;
    line-height: 1.8;
    color: hsl(var(--foreground) / 0.78);
  }

  :global(.about-work-list) {
    display: grid;
    gap: 0.9rem;
  }

  :global(.about-work-item) {
    display: grid;
    grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
    gap: 1rem 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  :global(.about-work-item:first-child) {
    padding-top: 0;
    border-top: none;
  }

  :global(.about-work-item-meta) {
    display: flex;
    align-items: flex-start;
  }

  :global(.about-work-item-date) {
    font-size: 0.95rem;
    font-family: var(--font-mono, "SFMono-Regular", Consolas, monospace);
    color: hsl(var(--primary));
    opacity: 0.9;
    letter-spacing: 0.01em;
  }

  :global(.about-work-item-body) {
    min-width: 0;
  }

  :global(.about-work-item-title) {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--fontc);
  }

  :global(.about-work-item-company) {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: hsl(var(--foreground) / 0.68);
  }

  :global(.about-work-arrow) {
    display: inline-block;
    font-size: 1.35rem;
    opacity: 0.6;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  :global(.about-work-link:hover .about-work-arrow) {
    transform: translate(4px, -4px);
    opacity: 1;
  }

  @media (max-width: 768px) {
    .about-page {
      padding: 0 1rem;
    }

    :global(.about-work-link) {
      padding: 1.25rem;
      gap: 1.4rem;
    }

    :global(.about-work-title-row) {
      align-items: center;
    }

    :global(.about-work-item) {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
  }

  @media (max-width: 480px) {
    :global(.about-work-link) {
      border-radius: 1rem;
    }

    :global(.about-work-description) {
      font-size: 0.94rem;
    }

    :global(.about-work-item-title) {
      font-size: 1rem;
    }
  }
</style>
