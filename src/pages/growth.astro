---
import { getBlogPosts } from "../content/config";
import Layout from "../layouts/Layout.astro";
import FormattedDate from "../components/blog/FormattedDate.astro";
import { ViewTransitions } from "astro:transitions";

const posts = await getBlogPosts();
const growthPosts = posts
  .filter((post) => post.data.tags?.some((tag) => tag === "成长"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const groupedPosts = growthPosts.reduce((groups, post) => {
  const year = post.data.pubDate.getFullYear().toString();
  if (!groups[year]) {
    groups[year] = [];
  }
  groups[year].push(post);
  return groups;
}, {});

const sortedGroupedPosts = Object.entries(groupedPosts).sort(
  ([yearA], [yearB]) => parseInt(yearB) - parseInt(yearA)
);
---

<Layout title="成长" description="记录成长的足迹">
  <ViewTransitions />

  <header class="growth-header">
    <h1 class="growth-title">成长笔记</h1>
    <p class="growth-subtitle">记录每一次思考与蜕变</p>
  </header>

  <section class="growth-list" data-year-timeline>
    {
      sortedGroupedPosts.length > 0 ? (
        sortedGroupedPosts.map(([year, yearPosts]) => (
          <div class="year-group" data-year-group>
            <div class="year-timeline">
              <div class="year-track" data-year-track></div>
              <div class="year-label" data-year-label>
                <span class="year-label-text">{year}</span>
              </div>
            </div>
            <ul class="post-list">
              {yearPosts.map((post) => (
                <li class="post-item">
                  <a href={`/blog/${post.fileName}`} class="post-link">
                    <span class="post-date">
                      <FormattedDate date={post.data.pubDate} />
                    </span>
                    <span class="post-title">{post.data.title}</span>
                    <svg class="post-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"/>
                      <polyline points="12 5 19 12 12 19"/>
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      ) : (
        <div class="empty-state">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
          <p>暂无成长类文章</p>
        </div>
      )
    }
  </section>

  <footer class="growth-footer">
    <a href="/blog" class="back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"/>
        <polyline points="12 19 5 12 12 5"/>
      </svg>
      返回博客列表
    </a>
  </footer>
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // 暴露给 View Transitions 用
  declare global {
    interface Window {
      __yearTimelineInit?: () => () => void;
    }
  }

  function initYearTimeline() {
    const root = document.querySelector<HTMLElement>("[data-year-timeline]");
    if (!root) return () => {};

    const groups = Array.from(
      root.querySelectorAll<HTMLElement>("[data-year-group]")
    );
    if (groups.length === 0) return () => {};

    // 尊重用户的"减少动效"偏好
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (reduceMotion) {
      // 降级：直接显示静态状态，保留 sticky
      groups.forEach((group) => {
        const track = group.querySelector<HTMLElement>("[data-year-track]");
        const label = group.querySelector<HTMLElement>("[data-year-label]");
        if (track) track.style.transform = "scaleY(1)";
        if (label) label.style.opacity = "1";
      });
      return () => {};
    }

    const ctx = gsap.context(() => {
      // ====== 方案 A：滚动跟随 + 进度填充 ======
      // 每个 year-group 独立创建时间线，统一管理
      const localGroupTimelines: gsap.core.Timeline[] = [];

      groups.forEach((group) => {
        const track = group.querySelector<HTMLElement>("[data-year-track]");
        const label = group.querySelector<HTMLElement>("[data-year-label]");

        if (!track || !label) return;

        // 1) 初始状态：时间线轨道高度为 0，年份标签从左侧淡入
        gsap.set(track, { scaleY: 0, transformOrigin: "top center" });
        gsap.set(label, { x: -24, opacity: 0 });

        // 2) 创建一个 Timeline 关联 ScrollTrigger
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: group,
            start: "top 85%", // 元素顶部到达视口 85% 时开始
            end: "top 20%", // 元素顶部到达视口 20% 时结束
            scrub: 1, // 平滑跟随（1秒延迟，更丝滑）
            // markers: true, // 调试用，发布前务必删除
          },
        });

        // 时间轴入场：轨道从顶部向下展开 + 年份标签从左侧滑入
        tl.to(track, {
          scaleY: 1,
          ease: "power3.out",
          duration: 0.6,
        }).to(
          label,
          {
            x: 0,
            opacity: 1,
            ease: "power3.out",
            duration: 0.5,
          },
          "<0.1" // 比上一个动画晚 0.1s 开始
        );

        // 滚动中：年份做轻微的视差跟随（在 1.2 范围内回弹）
        tl.to(
          label,
          {
            yPercent: -8,
            ease: "sine.inOut",
            duration: 0.4,
          },
          ">"
        ).to(label, {
          yPercent: 0,
          ease: "sine.inOut",
          duration: 0.4,
        });

        localGroupTimelines.push(tl);
      });

      // 3) 列表项交错入场（强化叙事节奏）
      const allItems = root.querySelectorAll<HTMLElement>(".post-item");
      gsap.set(allItems, { y: 16, opacity: 0 });
      ScrollTrigger.batch(allItems, {
        start: "top 90%",
        onEnter: (batch) => {
          gsap.to(batch, {
            y: 0,
            opacity: 1,
            duration: 0.5,
            ease: "power2.out",
            stagger: 0.06,
            overwrite: true,
          });
        },
        onEnterBack: (batch) => {
          gsap.to(batch, {
            y: 0,
            opacity: 1,
            duration: 0.5,
            ease: "power2.out",
            stagger: 0.06,
            overwrite: true,
          });
        },
      });
    }, root);

    // 返回清理函数（View Transitions 切换页面时调用）
    return () => {
      ctx.revert();
      // 清理 will-change，避免内存泄漏
      groups.forEach((group) => {
        const track = group.querySelector<HTMLElement>("[data-year-track]");
        const label = group.querySelector<HTMLElement>("[data-year-label]");
        if (track) track.style.willChange = "";
        if (label) label.style.willChange = "";
      });
      ScrollTrigger.refresh();
    };
  }

  // 暴露初始化函数
  window.__yearTimelineInit = initYearTimeline;

  // 页面首次加载
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      window.__yearTimelineCleanup?.();
      window.__yearTimelineCleanup = initYearTimeline();
    });
  } else {
    window.__yearTimelineCleanup?.();
    window.__yearTimelineCleanup = initYearTimeline();
  }

  // Astro View Transitions 导航后重新初始化
  document.addEventListener("astro:page-load", () => {
    window.__yearTimelineCleanup?.();
    window.__yearTimelineCleanup = initYearTimeline();
  });
</script>

<script>
  // 补充全局类型声明（避免 TS 报错）
  declare global {
    interface Window {
      __yearTimelineCleanup?: () => void;
    }
  }
</script>

<style>
  .growth-header {
    text-align: center;
    padding: 3rem 1rem 2rem;
    border-bottom: 1px solid rgba(133, 133, 168, 0.15);
    margin-bottom: 2rem;
  }

  .header-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, rgba(155, 219, 238, 0.15), rgba(255, 179, 0, 0.1));
    border: 1px solid rgba(155, 219, 238, 0.3);
    border-radius: 16px;
    color: var(--hc);
    margin-bottom: 1.5rem;
    transition: all 0.3s ease;
  }

  .header-icon:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(155, 219, 238, 0.2);
  }

  .growth-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--fontc);
    margin: 0 0 0.5rem 0;
    font-family: var(--font-family-base);
  }

  .growth-subtitle {
    font-size: 0.95rem;
    color: var(--gray);
    margin: 0;
    font-family: var(--font-family-mono);
  }

  .growth-list {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .year-group {
    margin-bottom: 2rem;
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  .year-timeline {
    position: relative;
    min-height: 100%;
  }

  .year-track {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(133, 133, 168, 0.15);
    transform-origin: top center;
    will-change: transform;
  }

  .year-label {
    position: sticky;
    top: 5rem;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.75rem 0.5rem 0;
    background: linear-gradient(90deg, hsl(var(--background) / 0.92) 70%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    will-change: transform, opacity;
  }

  .year-label-text {
    font-family: var(--font-family-mono);
    font-size: 1.75rem;
    color: var(--gray);
    padding-left: 0.5rem;
    border-left: 3px solid var(--hc);
    line-height: 1.2;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-item {
    margin-bottom: 0.5rem;
  }

  .post-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: linear-gradient(145deg, rgba(40, 42, 53, 0.6), rgba(51, 51, 56, 0.4));
    border: 1px solid rgba(155, 219, 238, 0.15);
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .post-link:hover {
    background: linear-gradient(145deg, rgba(40, 42, 53, 0.8), rgba(51, 51, 56, 0.6));
    border-color: rgba(155, 219, 238, 0.4);
    transform: translateX(4px);
    box-shadow: 0 4px 20px rgba(155, 219, 238, 0.1);
  }

  .post-date {
    font-family: var(--font-family-mono);
    font-size: 0.85rem;
    color: var(--gray);
    min-width: 100px;
    flex-shrink: 0;
  }

  .post-title {
    flex: 1;
    font-family: var(--font-family-mono);
    font-size: 0.95rem;
    color: var(--fontc);
    transition: color 0.25s ease;
  }

  .post-link:hover .post-title {
    color: var(--hc);
  }

  .post-arrow {
    color: var(--gray);
    flex-shrink: 0;
    transition: all 0.25s ease;
    opacity: 0;
    transform: translateX(-8px);
  }

  .post-link:hover .post-arrow {
    color: var(--orange);
    opacity: 1;
    transform: translateX(0);
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    color: var(--gray);
    text-align: center;
  }

  .empty-state svg {
    margin-bottom: 1rem;
    opacity: 0.5;
  }

  .empty-state p {
    font-family: var(--font-family-mono);
    margin: 0;
  }

  .growth-footer {
    max-width: 800px;
    margin: 3rem auto 0;
    padding: 2rem 1rem;
    border-top: 1px solid rgba(133, 133, 168, 0.15);
    text-align: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    color: var(--gray);
    text-decoration: none;
    font-family: var(--font-family-mono);
    font-size: 0.9rem;
    border: 1px solid rgba(133, 133, 168, 0.3);
    border-radius: 2rem;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .back-link:hover {
    color: var(--hc);
    border-color: var(--hc);
    transform: translateX(-4px);
  }

  @media (max-width: 640px) {
    .growth-title {
      font-size: 1.5rem;
    }

    .post-link {
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .post-date {
      min-width: auto;
    }

    .post-title {
      width: calc(100% - 24px);
    }

    .post-arrow {
      display: none;
    }

    .year-label-text {
      font-size: 1.25rem;
    }

    .year-group {
      grid-template-columns: 60px 1fr;
      gap: 1rem;
    }

    .year-label {
      top: 4rem;
    }
  }
</style>
