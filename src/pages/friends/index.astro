---
import BlogPost from "../../layouts/BlogPost.astro";
import { friendLinksZh, friendLinksInvalid } from '../../content/friendlinks/friends.mjs';
import MarqueeShow from "../../components/ui/MarqueeDemo";

---
<BlogPost
    title="友链"
    description="friend"
    pubDate={new Date("2024-03-29")}
    random={false}
  >
    <section class="friends-section">
      <h2 class="section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        我的朋友们
      </h2>
      <div class="friends-grid">
        {friendLinksZh.map((link) => (
          <a href={link.link} target="_blank" class="friend-card" data-umami-event="Button-toFriend">
            {link.tag && <span class="friend-tag">{link.tag}</span>}
            <div class="friend-avatar">
              <img src={link.avatar} alt={link.name} onerror="this.src='/favicon.svg';" loading="lazy"/>
            </div>
            <div class="friend-info">
              <span class="friend-name">{link.name}</span>
              <span class="friend-desc">{link.description}</span>
            </div>
            <svg class="friend-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        ))}
      </div>
    </section>

    <details class="info-details">
      <summary>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11a9 9 0 0 1 9 9"/>
          <path d="M4 4a16 16 0 0 1 16 16"/>
          <circle cx="5" cy="19" r="1"/>
        </svg>
        无效的友链
        <span class="details-count">({friendLinksInvalid.length})</span>
      </summary>
      <div class="invalid-links">
        {friendLinksInvalid.map((link) => (
          <a href={link.link} target="_blank" class="invalid-link">
            {link.name}
          </a>
        ))}
      </div>
    </details>

    <details class="info-details add-friend" open>
      <summary>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="16"/>
          <line x1="8" y1="12" x2="16" y2="12"/>
        </svg>
        欢迎添加我的友链
      </summary>
      <div class="friend-info-card">
        <div class="info-row">
          <span class="info-label">图标</span>
          <code class="info-value">https://blog.sanxiaoxing.cn/favicon.svg</code>
        </div>
        <div class="info-row">
          <span class="info-label">名称</span>
          <code class="info-value">SanXiaoXing</code>
        </div>
        <div class="info-row">
          <span class="info-label">链接</span>
          <code class="info-value">https://blog.sanxiaoxing.cn/</code>
        </div>
        <div class="info-row">
          <span class="info-label">描述</span>
          <code class="info-value">开心每一天</code>
        </div>
      </div>
    </details>

    <style>
      .section-divider {
        display: flex;
        align-items: center;
        margin: 2rem 0;
      }

      .section-divider::after {
        content: "";
        flex: 1;
        border-bottom: 2px dashed rgba(155, 219, 238, 0.2);
        margin-left: 1rem;
      }

      .friends-section {
        margin-bottom: 2rem;
      }

      .section-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-family: var(--font-family-mono);
        font-size: 1.25rem;
        color: var(--fontc);
        margin: 0 0 1.5rem 0;
      }

      .section-title svg {
        color: var(--hc);
      }

      .friends-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1rem;
      }

      .friend-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: linear-gradient(145deg, rgba(40, 42, 53, 0.6), rgba(51, 51, 56, 0.4));
        border: 1px solid rgba(155, 219, 238, 0.15);
        border-radius: 12px;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        cursor: pointer;
      }

      .friend-card:hover {
        transform: translateY(-2px);
        border-color: rgba(255, 179, 0, 0.5);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2),
                    0 0 20px rgba(255, 179, 0, 0.15);
      }

      .friend-tag {
        position: absolute;
        right: 0;
        top: 0;
        padding: 0.25rem 0.5rem;
        font-size: 0.7rem;
        font-family: var(--font-family-mono);
        background: var(--orange);
        color: var(--bgc);
        border-bottom-left-radius: 8px;
        transition: opacity 0.3s ease;
      }

      .friend-card:hover .friend-tag {
        opacity: 0;
      }

      .friend-avatar {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        --avatar-size: 48px;
        width: var(--avatar-size);
        height: var(--avatar-size);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: visible;
      }

      .friend-card:hover .friend-avatar {
        --avatar-size: 0px;
        opacity: 0;
        margin-right: -1rem;
        transform: scale(0);
      }

      .friend-avatar img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid rgba(155, 219, 238, 0.2);
        transition: border-color 0.3s ease;
      }

      .friend-card:hover .friend-avatar img {
        border-color: var(--hc);
      }

      .friend-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .friend-name {
        font-family: var(--font-family-mono);
        font-size: 1rem;
        font-weight: 600;
        color: var(--fontc);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .friend-desc {
        font-size: 0.8rem;
        color: var(--gray);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .friend-arrow {
        flex-shrink: 0;
        color: var(--gray);
        opacity: 0;
        transform: translateX(-8px);
        transition: all 0.3s ease;
      }

      .friend-card:hover .friend-arrow {
        opacity: 1;
        transform: translateX(0);
        color: var(--orange);
      }

      .info-details {
        margin-bottom: 1rem;
        background: linear-gradient(145deg, rgba(40, 42, 53, 0.6), rgba(51, 51, 56, 0.4));
        border: 1px solid rgba(155, 219, 238, 0.15);
        border-radius: 12px;
        overflow: hidden;
      }

      .info-details summary {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        font-family: var(--font-family-mono);
        font-size: 0.95rem;
        color: var(--gray);
        cursor: pointer;
        transition: all 0.25s ease;
        list-style: none;
      }

      .info-details summary::-webkit-details-marker {
        display: none;
      }

      .info-details summary svg {
        color: var(--hc);
      }

      .info-details summary:hover {
        color: var(--fontc);
        background: rgba(155, 219, 238, 0.05);
      }

      .info-details[open] summary {
        color: var(--fontc);
        border-bottom: 1px solid rgba(155, 219, 238, 0.1);
      }

      .details-count {
        color: var(--gray);
        font-size: 0.85rem;
      }

      .invalid-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 1rem;
      }

      .invalid-link {
        padding: 0.4rem 0.8rem;
        font-family: var(--font-family-mono);
        font-size: 0.85rem;
        color: var(--gray);
        background: rgba(133, 133, 168, 0.1);
        border-radius: 6px;
        text-decoration: none;
        transition: all 0.25s ease;
      }

      .invalid-link:hover {
        color: var(--red);
        background: rgba(255, 85, 85, 0.1);
      }

      .add-friend .friend-info-card {
        padding: 1rem;
      }

      .info-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.6rem 0;
        border-bottom: 1px solid rgba(133, 133, 168, 0.1);
      }

      .info-row:last-child {
        border-bottom: none;
      }

      .info-label {
        flex-shrink: 0;
        width: 50px;
        font-family: var(--font-family-mono);
        font-size: 0.85rem;
        color: var(--gray);
      }

      .info-value {
        flex: 1;
        font-family: var(--font-family-mono);
        font-size: 0.85rem;
        color: var(--hc);
        background: transparent;
        border: none;
        padding: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      @media (max-width: 640px) {
        .friends-grid {
          grid-template-columns: 1fr;
        }

        .friend-card {
          padding: 0.875rem;
        }

        .friend-avatar img {
          width: 42px;
          height: 42px;
        }

        .friend-name {
          font-size: 0.95rem;
        }

        .friend-desc {
          font-size: 0.75rem;
        }
      }
    </style>
  </BlogPost>
