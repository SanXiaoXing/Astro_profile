---
import BlogPost from "../../layouts/BlogPost.astro";
import { friendLinksZh, friendLinksInvalid } from '../../content/friendlinks/friends.mjs';

---
<BlogPost
    title="友链"
    description="friend"
    pubDate={new Date("2024-03-29")}
    random={false}
  >
    <section class="friends-section">
      <h2 class="section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
          <circle cx="9" cy="7" r="4"/>
          <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
        </svg>
        我的朋友们
      </h2>
      <div class="friends-grid">
        {friendLinksZh.map((link, i) => (
          <a href={link.link} target="_blank" class="friend-card group" data-umami-event="Button-toFriend" style={`--i:${i}`}>
            {link.tag && <span class="friend-tag">{link.tag}</span>}
            <div class="relative shrink-0 h-[40px] w-[40px] sm:h-[46px] sm:w-[46px] rounded-full overflow-hidden bg-muted/40 ring-2 ring-[rgba(155,219,238,0.25)] shadow-[0_2px_8px_rgba(0,0,0,0.3)] transition-[width,height,opacity,margin,transform,box-shadow] duration-[var(--duration-slow)] ease-[var(--ease-out)] group-hover:h-0 group-hover:w-0 group-hover:opacity-0 group-hover:-mr-[0.875rem] group-hover:scale-0 group-hover:ring-[var(--hc)]">
              <img src={link.avatar} alt={link.name} onerror="this.src='/favicon.svg';" loading="lazy" class="block h-full w-full object-cover object-center !m-0 !p-0 transition-transform duration-300 group-hover:scale-105"/>
            </div>
            <div class="friend-info">
              <span class="friend-name">{link.name}</span>
              <span class="friend-desc">{link.description}</span>
            </div>
            <svg class="friend-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        ))}
      </div>
    </section>

    <details class="info-details">
      <summary>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11a9 9 0 0 1 9 9"/>
          <path d="M4 4a16 16 0 0 1 16 16"/>
          <circle cx="5" cy="19" r="1"/>
        </svg>
        无效的友链
        <span class="details-count">({friendLinksInvalid.length})</span>
      </summary>
      <div class="invalid-links">
        {friendLinksInvalid.map((link) => (
          <a href={link.link} target="_blank" class="invalid-link">
            {link.name}
          </a>
        ))}
      </div>
    </details>

    <details class="info-details add-friend" open>
      <summary>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="16"/>
          <line x1="8" y1="12" x2="16" y2="12"/>
        </svg>
        欢迎添加我的友链
      </summary>
      <div class="friend-info-card">
        <div class="info-row">
          <span class="info-label">图标</span>
          <div class="code-block-wrapper">
            <code class="info-value">https://blog.sanxiaoxing.cn/favicon.svg</code>
            <button class="copy-btn" data-copy="https://blog.sanxiaoxing.cn/favicon.svg" aria-label="Copy">
              <svg class="copy-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span class="copy-tooltip">复制成功!</span>
            </button>
          </div>
        </div>
        <div class="info-row">
          <span class="info-label">名称</span>
          <div class="code-block-wrapper">
            <code class="info-value">SanXiaoXing</code>
            <button class="copy-btn" data-copy="SanXiaoXing" aria-label="Copy">
              <svg class="copy-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span class="copy-tooltip">复制成功!</span>
            </button>
          </div>
        </div>
        <div class="info-row">
          <span class="info-label">链接</span>
          <div class="code-block-wrapper">
            <code class="info-value">https://blog.sanxiaoxing.cn/</code>
            <button class="copy-btn" data-copy="https://blog.sanxiaoxing.cn/" aria-label="Copy">
              <svg class="copy-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span class="copy-tooltip">复制成功!</span>
            </button>
          </div>
        </div>
        <div class="info-row">
          <span class="info-label">描述</span>
          <div class="code-block-wrapper">
            <code class="info-value">开心每一天</code>
            <button class="copy-btn" data-copy="开心每一天" aria-label="Copy">
              <svg class="copy-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span class="copy-tooltip">复制成功!</span>
            </button>
          </div>
        </div>
      </div>
    </details>

    <style>
      .section-divider {
        display: flex;
        align-items: center;
        margin: 2rem 0;
      }

      .section-divider::after {
        content: "";
        flex: 1;
        border-bottom: 2px dashed rgba(155, 219, 238, 0.2);
        margin-left: 1rem;
      }

      .friends-section {
        margin-bottom: 2rem;
      }

      .section-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-family: var(--font-family-mono);
        font-size: 1.25rem;
        color: var(--fontc);
        margin: 0 0 1.5rem 0;
        animation: friend-fade-up 480ms cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      .section-title svg {
        color: var(--hc);
      }

      .friends-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1rem;
      }

      .friend-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.875rem;
        padding: 1rem 1.25rem;
        background: hsl(var(--card) / 0.6);
        border: 1px solid hsl(var(--primary) / 0.15);
        border-radius: 10px;
        text-decoration: none;
        transition: background-color var(--duration-base) var(--ease-out),
                    border-color var(--duration-base) var(--ease-out),
                    box-shadow var(--duration-base) var(--ease-out),
                    transform var(--duration-base) var(--ease-out);
        overflow: hidden;
        cursor: pointer;
        /* ponytail: 级联入场。60ms × 卡片数；若友链 > 20 个可降到 40ms 避免久等。 */
        animation: friend-card-in 560ms cubic-bezier(0.16, 1, 0.3, 1) both;
        animation-delay: calc(var(--i, 0) * 60ms);
        will-change: transform, opacity;
      }

      .friend-card:hover {
        background: hsl(var(--card) / 0.8);
        border-color: hsl(var(--primary) / 0.4);
        transform: translateX(4px);
        box-shadow: 0 4px 20px hsl(var(--primary) / 0.1);
      }

      .friend-tag {
        position: absolute;
        right: 0;
        top: 0;
        padding: 0.25rem 0.5rem;
        font-size: 0.7rem;
        font-family: var(--font-family-mono);
        background: var(--orange);
        color: var(--bgc);
        border-bottom-left-radius: 8px;
        transition: opacity 0.3s ease;
      }

      .friend-card:hover .friend-tag {
        opacity: 0;
      }

      .friend-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .friend-name {
        font-family: var(--font-family-mono);
        font-size: 1rem;
        font-weight: 600;
        color: var(--fontc);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .friend-desc {
        font-size: 0.8rem;
        color: var(--gray);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .friend-arrow {
        flex-shrink: 0;
        color: var(--gray);
        opacity: 0;
        transform: translateX(-8px);
        transition: color var(--duration-base) var(--ease-out),
                    opacity var(--duration-base) var(--ease-out),
                    transform var(--duration-base) var(--ease-out);
      }

      .friend-card:hover .friend-arrow {
        opacity: 1;
        transform: translateX(0);
        color: var(--orange);
      }

      .info-details {
        margin-bottom: 1rem;
        background: hsl(var(--card) / 0.6);
        border: 1px solid hsl(var(--primary) / 0.15);
        border-radius: 10px;
        overflow: hidden;
      }

      .info-details summary {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        font-family: var(--font-family-mono);
        font-size: 0.95rem;
        color: var(--gray);
        cursor: pointer;
        transition: color var(--duration-base) var(--ease-out),
                    background-color var(--duration-base) var(--ease-out);
        list-style: none;
      }

      .info-details summary::-webkit-details-marker {
        display: none;
      }

      .info-details summary svg {
        color: var(--hc);
      }

      .info-details summary:hover {
        color: var(--fontc);
        background: rgba(155, 219, 238, 0.05);
      }

      .info-details[open] summary {
        color: var(--fontc);
        border-bottom: 1px solid rgba(155, 219, 238, 0.1);
      }

      .details-count {
        color: var(--gray);
        font-size: 0.85rem;
      }

      .invalid-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 1rem;
      }

      .invalid-link {
        padding: 0.4rem 0.8rem;
        font-family: var(--font-family-mono);
        font-size: 0.85rem;
        color: var(--gray);
        background: rgba(133, 133, 168, 0.1);
        border-radius: 6px;
        text-decoration: none;
        transition: color var(--duration-base) var(--ease-out),
                    background-color var(--duration-base) var(--ease-out);
      }

      .invalid-link:hover {
        color: var(--red);
        background: rgba(255, 85, 85, 0.1);
      }

      .add-friend .friend-info-card {
        padding: 1rem;
      }

      .info-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.6rem 0;
        border-bottom: 1px solid rgba(133, 133, 168, 0.1);
      }

      .info-row:last-child {
        border-bottom: none;
      }

      .info-label {
        flex-shrink: 0;
        width: 50px;
        font-family: var(--font-family-mono);
        font-size: 0.85rem;
        color: var(--gray);
      }

      .code-block-wrapper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex: 1;
        background: rgba(155, 219, 238, 0.05);
        border: 1px solid rgba(133, 133, 168, 0.2);
        border-radius: 6px;
        padding: 0.4rem 0.6rem;
        overflow: hidden;
        transition: border-color var(--duration-base) var(--ease-out),
                    background-color var(--duration-base) var(--ease-out);
        min-width: 0;
      }

      .code-block-wrapper:hover {
        border-color: rgba(155, 219, 238, 0.4);
        background: rgba(155, 219, 238, 0.1);
      }

      .info-value {
        flex: 1;
        font-family: var(--font-family-mono);
        font-size: 0.85rem;
        color: var(--hc);
        background: transparent;
        border: none;
        padding: 0;
        margin: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .copy-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: none;
        color: var(--gray);
        cursor: pointer;
        padding: 0.25rem;
        border-radius: 4px;
        transition: color var(--duration-base) var(--ease-out),
                    background-color var(--duration-base) var(--ease-out);
        margin-left: 0.5rem;
        position: relative;
        flex-shrink: 0;
      }

      .copy-btn:hover {
        color: var(--fontc);
        background: rgba(133, 133, 168, 0.15);
      }

      .copy-btn.copied {
        color: var(--green);
      }

      .copy-tooltip {
        position: absolute;
        right: 120%;
        top: 50%;
        transform: translateY(-50%);
        background: var(--fontc);
        color: var(--bgc);
        font-size: 0.7rem;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        opacity: 0;
        visibility: hidden;
        transition: opacity var(--duration-fast) var(--ease-out),
                    visibility var(--duration-fast) var(--ease-out),
                    right var(--duration-fast) var(--ease-out);
        white-space: nowrap;
        pointer-events: none;
        font-family: var(--font-family-mono);
        z-index: 10;
      }

      .copy-btn.copied .copy-tooltip {
        opacity: 1;
        visibility: visible;
        right: 140%;
      }

      @media (max-width: 640px) {
        .friends-grid {
          grid-template-columns: 1fr;
        }

        .friend-card {
          padding: 0.75rem 0.875rem;
          gap: 0.75rem;
        }

        .friend-name {
          font-size: 0.95rem;
        }

        .friend-desc {
          font-size: 0.75rem;
        }
      }

      @keyframes friend-card-in {
        from {
          opacity: 0;
          transform: translateY(12px) scale(0.98);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      @keyframes friend-fade-up {
        from {
          opacity: 0;
          transform: translateY(8px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .info-details {
        animation: friend-fade-up 480ms cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      .info-details:nth-of-type(2) {
        animation-delay: 80ms;
      }

      .info-details:nth-of-type(3) {
        animation-delay: 160ms;
      }

      @media (prefers-reduced-motion: reduce) {
        .section-title,
        .friend-card,
        .info-details {
          animation: none;
        }
        .friend-card {
          will-change: auto;
        }
      }
    </style>
  </BlogPost>

<script>
  function initCopyButtons() {
    const copyBtns = document.querySelectorAll('.copy-btn');
    copyBtns.forEach(btn => {
      // Create a clean clone to avoid duplicate event listeners during view transitions
      const newBtn = btn.cloneNode(true) as HTMLElement;
      btn.parentNode?.replaceChild(newBtn, btn);
      
      newBtn.addEventListener('click', async () => {
        const textToCopy = newBtn.getAttribute('data-copy');
        if (!textToCopy) return;

        try {
          await navigator.clipboard.writeText(textToCopy);
          
          const copyIcon = newBtn.querySelector('.copy-icon') as HTMLElement;
          const checkIcon = newBtn.querySelector('.check-icon') as HTMLElement;
          
          if (copyIcon && checkIcon) {
            copyIcon.style.display = 'none';
            checkIcon.style.display = 'block';
          }
          
          newBtn.classList.add('copied');
          
          setTimeout(() => {
            if (copyIcon && checkIcon) {
              copyIcon.style.display = 'block';
              checkIcon.style.display = 'none';
            }
            newBtn.classList.remove('copied');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy: ', err);
        }
      });
    });
  }

  initCopyButtons();
  document.addEventListener('astro:page-load', initCopyButtons);
</script>
