---
import { getCollection } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import TableOfContents from '../../components/blog/utils/TableOfContents.astro';
import { ViewTransitions } from 'astro:transitions';
import { paperLink, relatedPapers } from '../../lib/paper-links.mjs';

export async function getStaticPaths() {
    const allPosts = await getCollection('blog'); // 获取原始未过滤数据
    return allPosts.map(page => ({
        params: { slug: page.slug.split('/').pop() }, // 年份目录不影响文章原有地址
        props: { page }
    }));
}

const { page } = Astro.props;
// const page = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await page.render();
const papers = page.data.hidden ? [] : relatedPapers(await getCollection('papers'), page.slug.split('/').pop());

---

<BlogPost {...page.data} relatedPapers={papers.map((paper) => ({ title: paper.data.title, href: paperLink(paper) }))}>
    <ViewTransitions />
    <TableOfContents headings={headings} />
    <hr>
    <p class="remark-plugin-frontmatter">预计 {remarkPluginFrontmatter.minutesRead}</p>
    <hr>
    <Content />
    <style>
        /* 设置特定段落的文字颜色 */
        .remark-plugin-frontmatter {
        color: var(--orange); /* 设置文字颜色 */
        }
    </style>
</BlogPost>
