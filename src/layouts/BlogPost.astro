---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/blog/FormattedDate.astro";
import Layout from "./Layout.astro";
import Hr from"../components/Hr.astro";
import Comments from"../components/Comments.astro"
import Random from "../components/blog/utils/Randomblogs.astro"
import { MessageWithReactions } from "../components/ui/reaction-chip";
import { getSupabaseAnon } from "../lib/supabase";
import { aggregateCounts } from "../lib/reactions";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage, tags, categories, comments, random } = Astro.props;

const postSlug = Astro.url.pathname;
let initialCounts: Record<string, number> = {};

try {
  const supabase = getSupabaseAnon();
  if (supabase) {
    const { data, error } = await supabase
      .from("reactions")
      .select("emoji")
      .eq("post_slug", postSlug);
    if (!error && data) {
      initialCounts = aggregateCounts(data as Array<{ emoji: string }>);
    }
  }
} catch (err) {
  console.warn("[reactions] build-time fetch failed:", err);
}
---

<Layout
  title={title}
  description={description}
  heroImage={heroImage}
  pubDate={pubDate}
  updatedDate={updatedDate}
>
  <article data-pagefind-body class="article-container">
    <header class="article-header">
      <h1 class="article-title">{title}</h1>
      
      <div class="article-meta">
        <div class="meta-row">
          <div class="date-container">
            {pubDate &&(
              <div class="date-wrapper">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                <time class="pub-date"><FormattedDate date={pubDate} /></time>
              </div>
            )}
            {updatedDate && (
              <div class="update-badge">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="23 4 23 10 17 10"/>
                  <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                </svg>
                <span>最后更新于 <time><FormattedDate date={updatedDate} /></time></span>
              </div>
            )}
          </div>
        </div>

        <div class="meta-row tags-categories">
          {!!categories?.length && (
            <div class="categories-wrapper">
              {categories.map((category) => (
                <a href={`/categories/${category}`} class="category-link" data-pagefind-filter="category">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                  </svg>
                  {category}
                </a>
              ))}
            </div>
          )}
          
          {!!categories?.length && !!tags?.length && (
            <div class="meta-divider"></div>
          )}
          
          {!!tags?.length && (
            <div class="tags-wrapper">
              {tags.map((tag) => (
                <a href={`/tags/${tag}`} class="tag-link" data-pagefind-filter="tag">#{tag}</a>
              ))}
            </div>
          )}
        </div>
      </div>
    </header>

    <div class="divider-wrapper">
      <div class="glow-line"></div>
    </div>

    <div class="prose headline">
      <slot />
    </div>

    <div class="reaction-container">
      <MessageWithReactions
        client:visible
        text="觉得这篇文章怎么样？给个反应吧！"
        postSlug={postSlug}
        initialCounts={initialCounts}
      />
    </div>

    {random !== false && (
      <div class="random-container">
        <Random />
      </div>
    )}
    
    {comments !== false && <Comments />}
  </article>

  <style>
    .article-container {
      max-width: 800px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }

    .article-header {
      text-align: center;
      margin-bottom: 2.5rem;
    }

    .article-title {
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--fontc);
      margin: 0 0 1.5rem 0;
      font-family: var(--font-family-base);
      line-height: 1.3;
    }

    .article-meta {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .meta-row {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
    }

    .tags-categories {
      gap: 1rem;
    }

    .date-container {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 36px;
      overflow: hidden;
      border-radius: 18px;
      background: rgba(133, 133, 168, 0.1);
      padding: 0 1.25rem;
      min-width: 200px;
    }

    .date-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      gap: 0.5rem;
      color: var(--gray);
      font-family: var(--font-family-mono);
      font-size: 0.9rem;
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
    }

    .date-wrapper svg {
      color: var(--hc);
    }

    .update-badge {
      position: absolute;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      gap: 0.5rem;
      color: var(--orange);
      font-family: var(--font-family-mono);
      font-size: 0.85rem;
      font-weight: 500;
      transform: translateY(100%);
      opacity: 0;
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease;
      white-space: nowrap;
    }

    .date-container:has(.update-badge):hover .date-wrapper {
      transform: translateY(-100%);
      opacity: 0;
    }

    .date-container:has(.update-badge):hover .update-badge {
      transform: translateY(0);
      opacity: 1;
    }

    .categories-wrapper, .tags-wrapper {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .category-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.35rem 0.75rem;
      background: linear-gradient(135deg, rgba(155, 219, 238, 0.15), rgba(255, 179, 0, 0.05));
      border: 1px solid rgba(155, 219, 238, 0.2);
      border-radius: 8px;
      color: var(--hc);
      font-family: var(--font-family-mono);
      font-size: 0.85rem;
      text-decoration: none;
      transition: all 0.25s ease;
    }

    .category-link:hover {
      background: linear-gradient(135deg, rgba(155, 219, 238, 0.25), rgba(255, 179, 0, 0.15));
      border-color: var(--hc);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(155, 219, 238, 0.15);
      color: var(--fontc);
    }

    .tag-link {
      color: var(--gray);
      font-family: var(--font-family-mono);
      font-size: 0.9rem;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .tag-link:hover {
      color: var(--orange);
    }

    .meta-divider {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--gray);
      opacity: 0.5;
    }

    .divider-wrapper {
      position: relative;
      width: 100%;
      height: 2px;
      margin: 2rem 0 3rem;
    }

    .glow-line {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(155, 219, 238, 0.5), transparent);
    }

    .glow-line::after {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100px;
      height: 1px;
      background: var(--hc);
      box-shadow: 0 0 10px var(--hc), 0 0 20px var(--hc);
    }

    .random-container {
      margin-top: 4rem;
      padding-top: 2rem;
      border-top: 1px solid rgba(133, 133, 168, 0.15);
    }

    .reaction-container {
      margin-top: 3rem;
      display: flex;
      justify-content: center;
    }

    @media (max-width: 640px) {
      .article-title {
        font-size: 2rem;
      }
      
      .tags-categories {
        flex-direction: column;
        gap: 0.75rem;
      }

      .meta-divider {
        display: none;
      }
    }
  </style>
</Layout>
