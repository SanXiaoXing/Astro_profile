---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import MobileHeader from "../components/MobileHeader.astro"; //移动端header
import Header from "../components/Header.astro";
import Footer from "../components/Footer_blog.astro";
type Props = CollectionEntry<"blog">["data"];

const { title, description } =
  Astro.props;
---

<!doctype html>
<html lang="zh">
  <head>
    <BaseHead  title={title} description={description} />
    <script id="MathJax-script" async src="https://img.asyncx.top/hexo/js/mathjax.js"></script>
    <script defer src="https://umami.sanxiaoxing.cn/script.js" data-website-id="ea11c5c3-4f18-44b9-8bfd-9e168a49edab"></script>
  </head>
  <body>
    <!-- <Mouse /> -->
    <Header title="SanXiaoXing"/>
    <MobileHeader title="SanXiaoXing" />
    <main transition:animate="fade">
    <slot />
	</main>
    <Footer />
    <div id="back-to-top" aria-label="Back to top" class="progress-wrap">
      <svg class="progress-circle svg-content" width="100%" height="100%" viewBox="-1 -1 102 102">
        <path d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98" />
      </svg>
      <div class="icon-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><!--!Font Awesome Free 6.5.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path fill="currentColor" d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM135.1 217.4l107.1-99.9c3.8-3.5 8.7-5.5 13.8-5.5s10.1 2 13.8 5.5l107.1 99.9c4.5 4.2 7.1 10.1 7.1 16.3c0 12.3-10 22.3-22.3 22.3H304v96c0 17.7-14.3 32-32 32H240c-17.7 0-32-14.3-32-32V256H150.3C138 256 128 246 128 233.7c0-6.2 2.6-12.1 7.1-16.3z"/></svg>
      </div>
    </div>
  </body>
  <style>
    .progress-wrap {
      position: fixed;
      right: 40px;
      bottom: 20px;
      height: 46px;
      width: 46px;
      cursor: pointer;
      display: block;
      border-radius: 50px;
      box-shadow: inset 0 0 0 2px hsl(var(--card));
      z-index: 9999;
      opacity: 0;
      visibility: hidden;
      transform: translateY(15px);
      transition: all 400ms cubic-bezier(0.4, 0, 0.2, 1);
      background-color: hsl(var(--background) / 0.8);
      backdrop-filter: blur(8px);
    }
    .progress-wrap.active-progress {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .progress-wrap:hover {
      box-shadow: inset 0 0 0 2px hsl(var(--primary));
      transform: translateY(-5px);
      filter: drop-shadow(0 0 10px hsl(var(--primary) / 0.5));
    }
    .progress-wrap::after {
      position: absolute;
      content: '';
      inset: -4px;
      border-radius: inherit;
      background: linear-gradient(135deg, var(--hc), hsl(var(--primary)), var(--purple));
      z-index: -1;
      opacity: 0;
      transition: opacity 0.4s ease;
    }
    .progress-wrap:hover::after {
      opacity: 0.3;
    }
    .progress-wrap svg.progress-circle path {
      stroke: hsl(var(--primary));
      stroke-width: 4;
      box-sizing: border-box;
      transition: all 200ms linear;
      fill: none;
    }
    .progress-wrap .icon-wrap {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: hsl(var(--foreground));
      transition: all 400ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    .progress-wrap:hover .icon-wrap {
      color: hsl(var(--primary));
      transform: translateY(-2px);
    }
    .progress-wrap .icon-wrap svg {
      width: 20px;
      height: 20px;
    }
  </style>
  <script>
    // 获取元素
    const progressWrap = document.querySelector('.progress-wrap');
    const progressPath = document.querySelector('.progress-wrap path') as SVGPathElement;

    if (progressWrap && progressPath) {
      const pathLength = progressPath.getTotalLength();
      
      // 初始化进度条
      progressPath.style.transition = 'none';
      progressPath.style.strokeDasharray = pathLength + ' ' + pathLength;
      progressPath.style.strokeDashoffset = String(pathLength);
      progressPath.getBoundingClientRect();
      progressPath.style.transition = 'stroke-dashoffset 10ms linear';

      // 更新进度条
      const updateProgress = function () {
        const scroll = window.scrollY || window.pageYOffset;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const progress = pathLength - (scroll * pathLength / height);
        progressPath.style.strokeDashoffset = String(progress);
      }

      // 监听滚动事件
      window.addEventListener('scroll', () => {
        updateProgress();
        
        // 显示/隐藏按钮
        if (window.pageYOffset > 100) {
          progressWrap.classList.add('active-progress');
        } else {
          progressWrap.classList.remove('active-progress');
        }
      });

      // 初始更新一次
      updateProgress();

      // 点击返回顶部
      progressWrap.addEventListener("click", (e) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }
  </script>
</html>
