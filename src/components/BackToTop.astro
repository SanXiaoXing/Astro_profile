---
/**
 * ponytail: 100+ 行重复代码提取为共享组件
 */
---
<div id="back-to-top" aria-label="Back to top" class="progress-wrap">
  <svg class="progress-circle svg-content" width="100%" height="100%" viewBox="-1 -1 102 102">
    <path d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98" />
  </svg>
  <div class="icon-wrap">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path fill="currentColor" d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM135.1 217.4l107.1-99.9c3.8-3.5 8.7-5.5 13.8-5.5s10.1 2 13.8 5.5l107.1 99.9c4.5 4.2 7.1 10.1 7.1 16.3c0 12.3-10 22.3-22.3 22.3H304v96c0 17.7-14.3 32-32 32H240c-17.7 0-32-14.3-32-32V256H150.3C138 256 128 246 128 233.7c0-6.2 2.6-12.1 7.1-16.3z"/></svg>
  </div>
</div>

<style>
  .progress-wrap {
    position: fixed;
    right: 40px;
    bottom: 20px;
    height: 46px;
    width: 46px;
    cursor: pointer;
    display: block;
    border-radius: 50px;
    box-shadow: inset 0 0 0 2px hsl(var(--card));
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transform: translateY(15px);
    transition: opacity var(--duration-slow) var(--ease-out),
                transform var(--duration-slow) var(--ease-out),
                box-shadow var(--duration-slow) var(--ease-out),
                visibility 0s linear var(--duration-slow);
    background-color: hsl(var(--background) / 0.8);
    backdrop-filter: blur(8px);
  }
  .progress-wrap.active-progress {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: opacity var(--duration-slow) var(--ease-out),
                transform var(--duration-slow) var(--ease-out),
                box-shadow var(--duration-slow) var(--ease-out),
                visibility 0s;
  }
  .progress-wrap:hover {
    box-shadow:
      inset 0 0 0 2px hsl(var(--primary)),
      inset 0 1px 0 hsl(var(--primary) / 0.15),
      0 8px 24px hsl(var(--primary) / 0.25),
      0 2px 8px hsl(var(--foreground) / 0.1);
    transform: translateY(-3px) scale(1.02);
  }
  .progress-wrap::after {
    position: absolute;
    content: '';
    inset: -4px;
    border-radius: inherit;
    background: linear-gradient(135deg, var(--hc), hsl(var(--primary)), var(--purple));
    z-index: -1;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .progress-wrap:hover::after {
    opacity: 0.15;
  }
  .progress-wrap:active {
    transform: translateY(-1px) scale(0.98);
    transition-duration: 100ms;
  }
  .progress-wrap svg.progress-circle path {
    stroke: hsl(var(--primary));
    stroke-width: 4;
    box-sizing: border-box;
    transition: stroke var(--duration-base) var(--ease-out);
    fill: none;
  }
  .progress-wrap .icon-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: hsl(var(--foreground));
    transition: color var(--duration-base) var(--ease-out),
                transform var(--duration-base) var(--ease-out);
  }
  .progress-wrap:hover .icon-wrap {
    color: hsl(var(--primary));
    transform: translateY(-1px);
  }
  .progress-wrap:active .icon-wrap {
    transform: translateY(0);
  }
  .progress-wrap .icon-wrap svg {
    width: 20px;
    height: 20px;
  }
  @media (max-width: 1024px) {
    .progress-wrap {
      display: none !important;
    }
  }
</style>

<script>
  declare global {
    interface Window {
      _scrollHandler?: () => void;
      _clickHandler?: (e: Event) => void;
    }
  }

  function initBackToTop() {
    const progressWrap = document.querySelector('.progress-wrap');
    const progressPath = document.querySelector('.progress-wrap path') as SVGPathElement;

    if (progressWrap && progressPath) {
      const pathLength = progressPath.getTotalLength();
      
      progressPath.style.transition = 'none';
      progressPath.style.strokeDasharray = pathLength + ' ' + pathLength;
      progressPath.style.strokeDashoffset = String(pathLength);
      progressPath.getBoundingClientRect();
      progressPath.style.transition = 'stroke-dashoffset 10ms linear';

      const updateProgress = function () {
        const scroll = window.scrollY || window.pageYOffset;
        const height = document.documentElement.scrollHeight - window.innerHeight;
        const progress = height > 0 ? pathLength - (scroll * pathLength / height) : pathLength;
        progressPath.style.strokeDashoffset = String(progress);
      }

      const newScrollHandler = () => {
        updateProgress();
        
        if (window.pageYOffset > 100) {
          progressWrap.classList.add('active-progress');
        } else {
          progressWrap.classList.remove('active-progress');
        }
      };

      window.removeEventListener('scroll', window._scrollHandler || (() => {}));
      window._scrollHandler = newScrollHandler;
      window.addEventListener('scroll', newScrollHandler);

      newScrollHandler();

      const clickHandler = (e: Event) => {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      };
      
      progressWrap.removeEventListener('click', window._clickHandler || (() => {}));
      window._clickHandler = clickHandler;
      progressWrap.addEventListener("click", clickHandler);
    }
  }

  document.addEventListener('DOMContentLoaded', initBackToTop);
  document.addEventListener('astro:page-load', initBackToTop);
</script>