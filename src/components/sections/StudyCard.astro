---
import Card from '../Card.astro'
import { Badge } from '../ui/badge'
import { STUDIES } from '../../lib/constants'
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-1" title="Study">
  <div class="mt-3 flex flex-wrap items-center gap-2">
    {
      STUDIES.map((study) => (
        <a href={study.link} target="__blank">
          <Badge variant="outline" className="border-muted/20 bg-transparent text-xs text-muted-foreground/70 hover:text-primary hover:border-primary/40 transition-colors">{study.institution}</Badge>
        </a>
      ))
    }
  </div>
</Card>