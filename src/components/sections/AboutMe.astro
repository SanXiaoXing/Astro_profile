---
import Card from '../Card.astro'
---

<Card
  href='/about'
  colSpan="md:col-span-1" rowSpan="md:row-span-1" title="About me">
  <div class="flex h-full flex-1 flex-col items-center justify-center text-center gap-3">
    <p class="text-sm text-foreground/85 leading-relaxed">
      <span class="whitespace-nowrap">Build. Learn. Reflect. Repeat.</span>
      <br />
      <span class="whitespace-nowrap">把想法变成系统，把经验沉淀成知识。</span>
    </p>
  </div>
</Card>