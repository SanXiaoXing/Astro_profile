---
import Card from '../Card.astro'
import { Button } from '../ui/button'
import { LINKS } from '../../lib/constants'
import { Github, Mail, Rss } from 'lucide-react'
import { FontAwesomeIcon } from '@fortawesome/react-fontawesome';
import { faGithub, faGit} from '@fortawesome/free-brands-svg-icons';
import { faHouseSignal } from '@fortawesome/free-solid-svg-icons';
import { FlipWords } from "../ui/flip-words";

const words = ["你好，欢迎来到我的博客", "这是我的开心乐园", "这里记录我的技术成长", "努力向上，天天开心啊！"];
---

<Card colSpan="md:col-span-3" rowSpan="md:row-span-2">
  <div class="flex h-full w-full items-center relative overflow-hidden">
    <div class="absolute -bottom-8 -right-8 z-0 opacity-20 md:opacity-30">
      <div
        class="h-48 w-48 rounded-full"
        style={{
          background: 'radial-gradient(circle, hsla(210, 80%, 60%, 0.3), transparent 70%)',
        }}
      />
    </div>
    <img
      width="240"
      height="240"
      src="/favicon.svg"
      class="pointer-events-none absolute -bottom-10 -right-10 z-[1] max-h-[200px] w-auto select-none opacity-20 md:relative md:bottom-auto md:right-auto md:z-auto md:opacity-80 animate-float"
      alt="avatar"
    />
    <div class="flex flex-col justify-between gap-4 relative z-10 md:w-full md:max-w-2xl">
      <div>
        <h1 class="text-3xl font-bold tracking-tight md:text-5xl">
          <span class="text-foreground">SanXiaoXing</span>
          <span class="ml-2 text-muted-foreground/60 font-mono text-sm md:text-base">的博客</span>
        </h1>
      </div>
      <div class="h-12 flex items-center">
        <FlipWords words={words} duration={2500} className="text-lg md:text-xl text-muted-foreground/80 font-light" client:load />
      </div>
      <div class="flex gap-3">
        <a href={LINKS.github} aria-label="github profile" target="_blank">
          <Button variant="outline" size="icon" className="h-9 w-9 rounded-full border-muted/30 bg-transparent hover:bg-primary/10 hover:border-primary/40 transition-all duration-300">
            <FontAwesomeIcon icon={faGithub} className="h-4 w-4 text-muted-foreground hover:text-primary" />
          </Button>
        </a>
        <a href={LINKS.gitee} aria-label="gitee profile" target="_blank">
          <Button variant="outline" size="icon" className="h-9 w-9 rounded-full border-muted/30 bg-transparent hover:bg-secondary/10 hover:border-secondary/40 transition-all duration-300">
            <FontAwesomeIcon icon={faGit} className="h-4 w-4 text-muted-foreground hover:text-secondary" />
          </Button>
        </a>
        <a href={LINKS.homepage} aria-label="homepage profile" target="_blank">
          <Button variant="outline" size="icon" className="h-9 w-9 rounded-full border-muted/30 bg-transparent hover:bg-accent/10 hover:border-accent/40 transition-all duration-300">
            <FontAwesomeIcon icon={faHouseSignal} className="h-4 w-4 text-muted-foreground hover:text-accent" />
          </Button>
        </a>
        <a href={LINKS.mail} aria-label="mail profile" target="_blank">
          <Button variant="outline" size="icon" className="h-9 w-9 rounded-full border-muted/30 bg-transparent hover:bg-primary/10 hover:border-primary/40 transition-all duration-300">
            <Mail className="h-4 w-4 text-muted-foreground hover:text-primary" />
          </Button>
        </a>
        <a href={LINKS.rss} aria-label="rss profile" target="_blank">
          <Button variant="outline" size="icon" className="h-9 w-9 rounded-full border-muted/30 bg-transparent hover:bg-accent/10 hover:border-accent/40 transition-all duration-300">
            <Rss className="h-4 w-4 text-muted-foreground hover:text-accent" />
          </Button>
        </a>
      </div>
    </div>
  </div>
</Card>