---
const today = new Date();
---

<footer>
	<div class="CC"><a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a></div>
	<div class="footer-text">Build with <a href="https://astro.build/">Astro</a> & <a href="https://github.com/SanXiaoXing/Template_Of_Astro" data-umami-event="Button-toRepo">Template</a>.</div>
	<div class="footer-text">&copy; 2023 - {today.getFullYear()}</div>
</footer>
<style>
	.CC {
		font-size: 0.6rem;
		margin-bottom: 5px;
	}
	.footer-text {
		padding: 5px 5px 5px 5px;
	}
	footer {
		font-size: 0.8rem;
		font-family: var(--font-family-mono);
		padding: 1em 1em 3em 1em;
		color: var(--gray);
		text-align: center;
		z-index: 10;
		position: relative;
		transition: color 0.3s ease;
	}

	footer a {
		font-family: var(--font-family-mono);
		color: var(--hc);
		position: relative;
		transition: color 0.3s ease;
	}

	footer a::after {
		content: '';
		position: absolute;
		bottom: -2px;
		left: 0;
		width: 0;
		height: 1px;
		background: hsl(var(--primary));
		transition: width 0.3s ease;
	}

	footer a:hover {
		color: hsl(var(--primary));
		text-decoration: none;
	}

	footer a:hover::after {
		width: 100%;
	}
</style>
