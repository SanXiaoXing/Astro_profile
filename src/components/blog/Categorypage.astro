---
import FormattedDate from "./FormattedDate.astro";
import { getBlogPosts } from "../../content/config";
const { category } = Astro.params;

export async function getData(category) {
  const postf = await getBlogPosts();
  const filteredPosts = postf
    .filter((post) => post.data.categories.includes(category))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return filteredPosts;
}

const postf = await getData(category);
const total = postf.length;
const latest = postf[0]?.data.pubDate;
---

<header class="category-detail">
  <p class="category-detail__crumb">
    <a href="/categories" class="category-detail__crumb-link">分类 / Categories</a>
    <span class="category-detail__crumb-sep" aria-hidden="true">/</span>
    <span class="category-detail__crumb-current">{category}</span>
  </p>

  <h1 class="category-detail__title">
    <span class="category-detail__mark" aria-hidden="true">▍</span>{category}
  </h1>

  <p class="category-detail__meta">
    <span class="category-detail__meta-num">{total}</span>
    <span class="category-detail__meta-unit">篇文章</span>
    {latest && (
      <>
        <span class="category-detail__meta-sep" aria-hidden="true">·</span>
        <span class="category-detail__meta-sub">最近更新</span>
        <FormattedDate date={latest} />
      </>
    )}
  </p>
</header>

<ul class="post-list" data-pagefind-ignore="all">
  {postf.map((post, i) => (
    <li class="post-list__item" style={`--i: ${i};`}>
      <a href={`/blog/${post.fileName}`} class="post-list__link">
        <time class="post-list__date">
          <FormattedDate date={post.data.pubDate} />
        </time>
        <span class="post-list__title">{post.data.title}</span>
        <svg
          class="post-list__arrow"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    </li>
  ))}
</ul>

<style>
  /* ── DETAIL HERO ──────────────────────────────────────────── */
  .category-detail {
    margin: clamp(1rem, 3vw, 2rem) 0 clamp(2.5rem, 6vw, 4rem);
    position: relative;
  }

  .category-detail::before {
    content: '';
    position: absolute;
    top: -0.5rem;
    left: 0;
    width: 24px;
    height: 1px;
    background: var(--hc);
  }

  .category-detail__crumb {
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
    color: var(--gray);
    margin: 0 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    letter-spacing: 0.05em;
  }

  .category-detail__crumb-link {
    color: var(--gray);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .category-detail__crumb-link:hover {
    color: var(--hc);
    border-bottom-color: var(--hc);
  }

  .category-detail__crumb-sep,
  .category-detail__crumb-current {
    color: var(--gray);
  }

  .category-detail__crumb-current {
    color: var(--fontc);
  }

  .category-detail__title {
    font-family: var(--font-family-display);
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fontc);
    margin: 0 0 1.25rem;
    word-break: break-word;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .category-detail__mark {
    color: var(--hc);
    font-size: 0.85em;
    line-height: 1;
    /* Perpetual micro-loop: gentle vertical breathe on the mark. */
    animation: markBreathe 5s ease-in-out infinite;
  }

  @keyframes markBreathe {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-detail__mark { animation: none; }
  }

  .category-detail__meta {
    font-family: var(--font-family-mono);
    font-size: 0.85rem;
    color: var(--gray);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    letter-spacing: 0.02em;
  }

  .category-detail__meta-num {
    color: var(--fontc);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    font-size: 1.05em;
  }

  .category-detail__meta-unit,
  .category-detail__meta-sub {
    color: var(--gray);
  }

  .category-detail__meta-sep {
    color: var(--hairline);
  }

  /* ── POST LIST ───────────────────────────────────────────── */
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 800px;
    min-height: 50vh;
  }

  .post-list__item {
    border-top: 1px solid var(--hairline);
    animation: rowEnter 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    animation-delay: calc(var(--i, 0) * 60ms);
  }

  .post-list__item:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .post-list__link {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 0.5rem;
    text-decoration: none;
    transition: background 0.3s ease;
    position: relative;
  }

  .post-list__link::before {
    content: '';
    position: absolute;
    inset: 0 -1rem;
    background: rgba(125, 211, 252, 0.04);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    border-radius: 0.25rem;
  }

  .post-list__link:hover::before {
    opacity: 1;
  }

  .post-list__date {
    font-family: var(--font-family-mono);
    font-size: 0.82rem;
    color: var(--gray);
    min-width: 110px;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .post-list__title {
    flex: 1;
    font-family: var(--font-family-base);
    font-size: 1.02rem;
    color: var(--fontc);
    transition: color 0.3s ease;
    font-weight: 500;
    line-height: 1.5;
  }

  .post-list__link:hover .post-list__title {
    color: var(--hc);
  }

  .post-list__arrow {
    color: var(--orange);
    flex-shrink: 0;
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .post-list__link:hover .post-list__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @keyframes rowEnter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-list__item { animation: none; }
    .post-list__arrow { transition: opacity 0.3s ease; transform: none; }
  }

  /* ── RESPONSIVE ──────────────────────────────────────────── */
  @media (max-width: 640px) {
    .post-list__link {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding: 1rem 0.5rem;
    }

    .post-list__date {
      min-width: auto;
      font-size: 0.78rem;
    }

    .post-list__title {
      font-size: 0.98rem;
      width: 100%;
    }

    .post-list__arrow {
      display: none;
    }

    .post-list__link::before {
      inset: 0 -0.5rem;
    }
  }
</style>
