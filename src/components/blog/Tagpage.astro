---
import PostYearList from "./PostYearList.astro";
import FormattedDate from "./FormattedDate.astro";
import { getBlogPosts, groupPostsByYear } from "../../content/config";
const { tag } = Astro.params;

export async function getData(tag) {
  const postf = await getBlogPosts();
  const filteredPosts = postf
    .filter((post) => post.data.tags.includes(tag))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return filteredPosts;
}

const postf = await getData(tag);
const total = postf.length;
const latest = postf[0]?.data.pubDate;

// Group by year — same shape as /blog so the article list reads as part
// of the blog surface, not a separate flat table.
const sortedGroupedPosts = groupPostsByYear(postf);
---

<header class="tag-detail">
  <p class="tag-detail__crumb">
    <a href="/tags" class="tag-detail__crumb-link">标签 / Tags</a>
    <span class="tag-detail__crumb-sep" aria-hidden="true">/</span>
    <span class="tag-detail__crumb-current">#{tag}</span>
  </p>

  <h1 class="tag-detail__title">
    <span class="tag-detail__hash" aria-hidden="true">#</span>{tag}
  </h1>

  <p class="tag-detail__meta">
    <span class="tag-detail__meta-num">{total}</span>
    <span class="tag-detail__meta-unit">篇文章</span>
    {latest && (
      <>
        <span class="tag-detail__meta-sep" aria-hidden="true">·</span>
        <span class="tag-detail__meta-sub">最近更新</span>
        <FormattedDate date={latest} />
      </>
    )}
  </p>
</header>

<PostYearList sortedGroupedPosts={sortedGroupedPosts} />

<style>
  /* ── DETAIL HERO ──────────────────────────────────────────── */
  .tag-detail {
    margin: clamp(1rem, 3vw, 2rem) 0 clamp(2.5rem, 6vw, 4rem);
    position: relative;
  }

  .tag-detail::before {
    content: '';
    position: absolute;
    top: -0.5rem;
    left: 0;
    width: 24px;
    height: 1px;
    background: var(--hc);
  }

  .tag-detail__crumb {
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
    color: var(--gray);
    margin: 0 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    letter-spacing: 0.05em;
  }

  .tag-detail__crumb-link {
    color: var(--gray);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .tag-detail__crumb-link:hover {
    color: var(--hc);
    border-bottom-color: var(--hc);
  }

  .tag-detail__crumb-sep,
  .tag-detail__crumb-current {
    color: var(--gray);
  }

  .tag-detail__crumb-current {
    color: var(--fontc);
  }

  .tag-detail__title {
    font-family: var(--font-family-display);
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fontc);
    margin: 0 0 1.25rem;
    word-break: break-word;
  }

  .tag-detail__hash {
    color: var(--hc);
    margin-right: 0.05em;
    display: inline-block;
    animation: hashPulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes hashPulse {
    0%, 90%, 100% { opacity: 1; transform: translateY(0); }
    95% { opacity: 0.55; transform: translateY(-1px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-detail__hash { animation: none; }
  }

  .tag-detail__meta {
    font-family: var(--font-family-mono);
    font-size: 0.85rem;
    color: var(--gray);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    letter-spacing: 0.02em;
  }

  .tag-detail__meta-num {
    color: var(--fontc);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    font-size: 1.05em;
  }

  .tag-detail__meta-unit,
  .tag-detail__meta-sub {
    color: var(--gray);
  }

  .tag-detail__meta-sep {
    color: var(--hairline);
  }

</style>
