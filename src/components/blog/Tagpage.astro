---
import FormattedDate from "./FormattedDate.astro";
import { getBlogPosts } from "../../content/config";
const { tag } = Astro.params;

export async function getData(tag) {
  const postf = await getBlogPosts();
  const filteredPosts = postf
    .filter((post) => post.data.tags.includes(tag))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return filteredPosts;
}

const postf = await getData(tag);
const total = postf.length;
const latest = postf[0]?.data.pubDate;

// Group by year — same shape as /blog so the article list reads as part
// of the blog surface, not a separate flat table.
const groupedPosts = postf.reduce((groups, post) => {
  const year = post.data.pubDate.getFullYear().toString();
  if (!groups[year]) groups[year] = [];
  groups[year].push(post);
  return groups;
}, {});
const sortedGroupedPosts = Object.entries(groupedPosts).sort(
  ([yearA], [yearB]) => parseInt(yearB) - parseInt(yearA)
);
---

<header class="tag-detail">
  <p class="tag-detail__crumb">
    <a href="/tags" class="tag-detail__crumb-link">标签 / Tags</a>
    <span class="tag-detail__crumb-sep" aria-hidden="true">/</span>
    <span class="tag-detail__crumb-current">#{tag}</span>
  </p>

  <h1 class="tag-detail__title">
    <span class="tag-detail__hash" aria-hidden="true">#</span>{tag}
  </h1>

  <p class="tag-detail__meta">
    <span class="tag-detail__meta-num">{total}</span>
    <span class="tag-detail__meta-unit">篇文章</span>
    {latest && (
      <>
        <span class="tag-detail__meta-sep" aria-hidden="true">·</span>
        <span class="tag-detail__meta-sub">最近更新</span>
        <FormattedDate date={latest} />
      </>
    )}
  </p>
</header>

<section class="blog-list" data-year-timeline>
  {
    sortedGroupedPosts.map(([year, yearPosts]) => (
      <div class="year-group" data-year-group>
        <div class="year-timeline">
          <div class="year-track" data-year-track />
          <div class="year-label" data-year-label>
            <span class="year-label-text">{year}</span>
          </div>
        </div>
        <ul class="post-list">
          {yearPosts.map((post) => (
            <li class="post-item">
              <a href={`/blog/${post.fileName}`} class="post-link">
                <span class="post-date">
                  <FormattedDate date={post.data.pubDate} />
                </span>
                <span class="post-title">{post.data.title}</span>
                <svg
                  class="post-arrow"
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  declare global {
    interface Window {
      __yearTimelineInit?: () => () => void;
      __yearTimelineCleanup?: () => void;
    }
  }

  function initYearTimeline() {
    const root = document.querySelector<HTMLElement>("[data-year-timeline]");
    if (!root) return () => {};

    const groups = Array.from(
      root.querySelectorAll<HTMLElement>("[data-year-group]")
    );
    if (groups.length === 0) return () => {};

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (reduceMotion) {
      groups.forEach((group) => {
        const track = group.querySelector<HTMLElement>("[data-year-track]");
        const label = group.querySelector<HTMLElement>("[data-year-label]");
        if (track) track.style.transform = "scaleY(1)";
        if (label) label.style.opacity = "1";
      });
      return () => {};
    }

    const ctx = gsap.context(() => {
      groups.forEach((group) => {
        const track = group.querySelector<HTMLElement>("[data-year-track]");
        const label = group.querySelector<HTMLElement>("[data-year-label]");

        if (!track || !label) return;

        gsap.set(track, { scaleY: 0, transformOrigin: "top center" });
        gsap.set(label, { x: -24, opacity: 0 });

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: group,
            start: "top 85%",
            end: "top 20%",
            scrub: 1,
          },
        });

        tl.to(track, {
          scaleY: 1,
          ease: "power3.out",
          duration: 0.6,
        }).to(
          label,
          {
            x: 0,
            opacity: 1,
            ease: "power3.out",
            duration: 0.5,
          },
          "<0.1"
        );

        tl.to(
          label,
          {
            yPercent: -8,
            ease: "sine.inOut",
            duration: 0.4,
          },
          ">"
        ).to(label, {
          yPercent: 0,
          ease: "sine.inOut",
          duration: 0.4,
        });
      });

      const allItems = root.querySelectorAll<HTMLElement>(".post-item");
      gsap.set(allItems, { y: 16, opacity: 0 });
      ScrollTrigger.batch(allItems, {
        start: "top 90%",
        onEnter: (batch) => {
          gsap.to(batch, {
            y: 0,
            opacity: 1,
            duration: 0.5,
            ease: "power2.out",
            stagger: 0.06,
            overwrite: true,
          });
        },
        onEnterBack: (batch) => {
          gsap.to(batch, {
            y: 0,
            opacity: 1,
            duration: 0.5,
            ease: "power2.out",
            stagger: 0.06,
            overwrite: true,
          });
        },
      });
    }, root);

    return () => {
      ctx.revert();
      groups.forEach((group) => {
        const track = group.querySelector<HTMLElement>("[data-year-track]");
        const label = group.querySelector<HTMLElement>("[data-year-label]");
        if (track) track.style.willChange = "";
        if (label) label.style.willChange = "";
      });
      ScrollTrigger.refresh();
    };
  }

  window.__yearTimelineInit = initYearTimeline;

  function bootTimeline() {
    window.__yearTimelineCleanup?.();
    window.__yearTimelineCleanup = initYearTimeline();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootTimeline);
  } else {
    bootTimeline();
  }

  document.addEventListener("astro:page-load", bootTimeline);
</script>

<style>
  /* ── DETAIL HERO ──────────────────────────────────────────── */
  .tag-detail {
    margin: clamp(1rem, 3vw, 2rem) 0 clamp(2.5rem, 6vw, 4rem);
    position: relative;
  }

  .tag-detail::before {
    content: '';
    position: absolute;
    top: -0.5rem;
    left: 0;
    width: 24px;
    height: 1px;
    background: var(--hc);
  }

  .tag-detail__crumb {
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
    color: var(--gray);
    margin: 0 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    letter-spacing: 0.05em;
  }

  .tag-detail__crumb-link {
    color: var(--gray);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .tag-detail__crumb-link:hover {
    color: var(--hc);
    border-bottom-color: var(--hc);
  }

  .tag-detail__crumb-sep,
  .tag-detail__crumb-current {
    color: var(--gray);
  }

  .tag-detail__crumb-current {
    color: var(--fontc);
  }

  .tag-detail__title {
    font-family: var(--font-family-display);
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fontc);
    margin: 0 0 1.25rem;
    word-break: break-word;
  }

  .tag-detail__hash {
    color: var(--hc);
    margin-right: 0.05em;
    display: inline-block;
    animation: hashPulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes hashPulse {
    0%, 90%, 100% { opacity: 1; transform: translateY(0); }
    95% { opacity: 0.55; transform: translateY(-1px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-detail__hash { animation: none; }
  }

  .tag-detail__meta {
    font-family: var(--font-family-mono);
    font-size: 0.85rem;
    color: var(--gray);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    letter-spacing: 0.02em;
  }

  .tag-detail__meta-num {
    color: var(--fontc);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    font-size: 1.05em;
  }

  .tag-detail__meta-unit,
  .tag-detail__meta-sub {
    color: var(--gray);
  }

  .tag-detail__meta-sep {
    color: var(--hairline);
  }

  /* ── BLOG-STYLE YEAR LIST ─────────────────────────────────── */
  /* Same card-row surface as /blog so the tag article list reads
     as part of the blog, not a separate flat table. */
  .blog-list {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .year-group {
    margin-bottom: 2rem;
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  .year-timeline {
    position: relative;
    min-height: 100%;
  }

  .year-track {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(133, 133, 168, 0.15);
    transform-origin: top center;
    will-change: transform;
  }

  .year-label {
    position: sticky;
    top: 5rem;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.75rem 0.5rem 0;
    background: linear-gradient(90deg, hsl(var(--background) / 0.92) 70%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    will-change: transform, opacity;
  }

  .year-label-text {
    font-family: var(--font-family-mono);
    font-size: 1.75rem;
    color: var(--gray);
    padding-left: 0.5rem;
    border-left: 3px solid var(--hc);
    line-height: 1.2;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-item {
    margin-bottom: 0.5rem;
  }

  .post-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: hsl(var(--card) / 0.6);
    border: 1px solid hsl(var(--primary) / 0.15);
    border-radius: 10px;
    text-decoration: none;
    transition: background-color var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out),
                box-shadow var(--duration-base) var(--ease-out),
                transform var(--duration-base) var(--ease-out);
    cursor: pointer;
  }

  .post-link:hover {
    background: hsl(var(--card) / 0.8);
    border-color: hsl(var(--primary) / 0.4);
    transform: translateX(4px);
    box-shadow: 0 4px 20px hsl(var(--primary) / 0.1);
  }

  .post-link:active {
    transform: translateX(4px) scale(0.97);
  }

  .post-date {
    font-family: var(--font-family-mono);
    font-size: 0.85rem;
    color: var(--gray);
    min-width: 100px;
    flex-shrink: 0;
  }

  .post-title {
    flex: 1;
    font-family: var(--font-family-mono);
    font-size: 0.95rem;
    color: var(--fontc);
    transition: color 0.25s ease;
  }

  .post-link:hover .post-title {
    color: var(--hc);
  }

  .post-arrow {
    color: var(--gray);
    flex-shrink: 0;
    transition: color var(--duration-base) var(--ease-out),
                opacity var(--duration-base) var(--ease-out),
                transform var(--duration-base) var(--ease-out);
    opacity: 0;
    transform: translateX(-8px);
  }

  .post-link:hover .post-arrow {
    color: var(--orange);
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 640px) {
    .year-label-text {
      font-size: 1.25rem;
    }

    .year-group {
      grid-template-columns: 60px 1fr;
      gap: 1rem;
    }

    .year-label {
      top: 4rem;
    }

    .post-link {
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .post-date {
      min-width: auto;
    }

    .post-title {
      width: calc(100% - 24px);
    }

    .post-arrow {
      display: none;
    }
  }
</style>