---
import { getBlogPosts } from "../content/config";

export async function getData() {
  const postf = await getBlogPosts();
  const filteredPosts = postf
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 5);
  return filteredPosts;
}

const postf = await getData();
---

<ul class="flex-wrap gap-8 list-none m-0 p-0" data-pagefind-ignore="all">
  {postf.map((post) => (
    <li class="flex mt-4">
      <a href={`/blog/${post.fileName}`} class="flex font-mono text-[var(--hc)] no-underline hover:text-[var(--orange)]">
        <p class="m-0 leading-none">{post.data.title}</p>
      </a>
    </li>
  ))}
</ul>

<style>
  @media (max-width: 720px) {
    ul {
      @apply gap-2;
    }
    ul li {
      @apply block w-full text-center;
    }
  }
</style>