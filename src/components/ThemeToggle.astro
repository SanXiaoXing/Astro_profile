---
/**
 * ponytail: 纯 Astro + 内联脚本，不引入 React hydration
 */
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label="切换主题"
  title="切换主题"
>
  <svg
    class="icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg
    class="icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  import { gsap } from 'gsap'

  const THEME_VARS = [
    '--bgc',
    '--fontc',
    '--hc',
    '--gray',
    '--glass-bg',
    '--glass-border',
    '--current-line',
  ]

  let isAnimating = false

  function updateThemeToggleIcon() {
    const isLight = document.documentElement.classList.contains('light')
    document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('data-theme', isLight ? 'light' : 'dark')
    })
  }

  function enableTransition() {
    const html = document.documentElement
    html.classList.add('theme-transition')
    window.setTimeout(() => {
      html.classList.remove('theme-transition')
    }, 400)
  }

  function getTheme() {
    return document.documentElement.classList.contains('light') ? 'light' : 'dark'
  }

  function setTheme(theme) {
    const html = document.documentElement
    html.classList.toggle('light', theme === 'light')
    html.setAttribute('data-theme', theme)
  }

  function readThemeVars(vars) {
    const styles = getComputedStyle(document.documentElement)
    return Object.fromEntries(vars.map((name) => [name, styles.getPropertyValue(name).trim()]))
  }

  function readThemeVarsFor(theme, vars) {
    const html = document.documentElement
    const wasLight = html.classList.contains('light')

    html.classList.toggle('light', theme === 'light')
    const values = readThemeVars(vars)
    html.classList.toggle('light', wasLight)

    return values
  }

  function clearInlineThemeVars(vars) {
    vars.forEach((name) => document.documentElement.style.removeProperty(name))
  }

  function getButtonCenter(btn) {
    const rect = btn.getBoundingClientRect()
    const x = rect.left + rect.width / 2
    const y = rect.top + rect.height / 2
    return { x, y }
  }

  function getMaxRadius(x, y) {
    const vw = window.innerWidth
    const vh = window.innerHeight
    const maxX = Math.max(x, vw - x)
    const maxY = Math.max(y, vh - y)
    return Math.ceil(Math.hypot(maxX, maxY))
  }

  function canUseClipPath() {
    if (!('CSS' in window) || typeof CSS.supports !== 'function') return false
    return (
      CSS.supports('clip-path: circle(10px at 10px 10px)') ||
      CSS.supports('-webkit-clip-path: circle(10px at 10px 10px)')
    )
  }

  function applyThemeInstant(nextTheme) {
    setTheme(nextTheme)
    try {
      localStorage.setItem('theme', nextTheme)
    } catch {}
    updateThemeToggleIcon()
    enableTransition()
    window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: nextTheme } }))
  }

  function initThemeToggle() {
    updateThemeToggleIcon()

    document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
      if (!(btn instanceof HTMLButtonElement)) return
      if (btn.dataset.bound === '1') return
      btn.dataset.bound = '1'

      btn.addEventListener('click', () => {
        if (isAnimating) return

        const currentTheme = getTheme()
        const nextTheme = currentTheme === 'light' ? 'dark' : 'light'

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        if (reduceMotion || !canUseClipPath()) {
          applyThemeInstant(nextTheme)
          return
        }

        let overlay
        let tl

        try {
          isAnimating = true
          btn.style.pointerEvents = 'none'

          const { x, y } = getButtonCenter(btn)
          const radius = getMaxRadius(x, y)

          const fromVars = readThemeVars(THEME_VARS)
          const toVars = readThemeVarsFor(nextTheme, THEME_VARS)

          overlay = document.createElement('div')
          overlay.setAttribute('data-theme-overlay', '')
          overlay.style.position = 'fixed'
          overlay.style.inset = '0'
          overlay.style.zIndex = '9999'
          overlay.style.pointerEvents = 'none'
          overlay.style.background = fromVars['--bgc'] || getComputedStyle(document.body).backgroundColor
          overlay.style.willChange = 'clip-path'
          overlay.style.clipPath = `circle(${radius}px at ${x}px ${y}px)`
          overlay.style.webkitClipPath = `circle(${radius}px at ${x}px ${y}px)`
          document.body.appendChild(overlay)

          tl = gsap.timeline({
            defaults: { duration: 0.7, ease: 'power2.inOut' },
            onComplete: () => {
              setTheme(nextTheme)
              try {
                localStorage.setItem('theme', nextTheme)
              } catch {}

              clearInlineThemeVars(THEME_VARS)
              overlay?.remove()
              updateThemeToggleIcon()
              window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: nextTheme } }))
              isAnimating = false
              btn.style.pointerEvents = ''
            },
            onInterrupt: () => {
              clearInlineThemeVars(THEME_VARS)
              overlay?.remove()
              applyThemeInstant(nextTheme)
              isAnimating = false
              btn.style.pointerEvents = ''
            },
          })

          tl.to(overlay, { clipPath: `circle(0px at ${x}px ${y}px)`, webkitClipPath: `circle(0px at ${x}px ${y}px)` }, 0)
          tl.to(document.documentElement, { ...toVars }, 0)
        } catch {
          clearInlineThemeVars(THEME_VARS)
          overlay?.remove()
          applyThemeInstant(nextTheme)
          isAnimating = false
          btn.style.pointerEvents = ''
        }
      })
    })
  }

  initThemeToggle()
  document.addEventListener('astro:page-load', initThemeToggle)
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    color: var(--gray);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    cursor: pointer;
    transition: all 0.25s ease;
    position: relative;
  }

  .theme-toggle:hover {
    color: hsl(var(--accent));
    background: hsla(var(--accent), 0.1);
    border-color: hsl(var(--accent) / 0.3);
  }

  .theme-toggle svg {
    position: absolute;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  .theme-toggle .icon-sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  .theme-toggle .icon-moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-toggle[data-theme='light'] .icon-sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-toggle[data-theme='light'] .icon-moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }
</style>
