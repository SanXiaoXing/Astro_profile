---
import ContentCard from './ContentCard.astro'
import { Card as ShadcnCard } from './ui/card'
import { SquareArrowOutUpRight } from 'lucide-react'

interface Props {
  title?: string
  body?: string
  colSpan?: string
  rowSpan?: string
  href?: string
  colorText?: string
}

const { title, body, colSpan, rowSpan, href, colorText } = Astro.props
---

<ShadcnCard
  className={`card-animate group relative col-span-1 h-auto w-full flex-none overflow-hidden p-6 shadow-lg transition-all duration-500 ease-out ${
    colSpan || 'md:col-span-2'
  } ${rowSpan || ''} ${href ? 'cursor-pointer' : ''}`}
  style={{
    background: 'var(--glass-bg)',
    backdropFilter: 'blur(16px)',
    WebkitBackdropFilter: 'blur(16px)',
    border: '1px solid var(--glass-border)',
    boxShadow: 'var(--glass-shadow)',
  }}
>
  <div
    class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
    style={{
      background: 'linear-gradient(135deg, hsla(210, 80%, 60%, 0.05), transparent 60%)',
      borderRadius: 'inherit',
    }}
  />
  {href ? (
    <a href={href} class={`relative z-10 flex h-full w-full flex-col ${colorText || ''}`}>
      <SquareArrowOutUpRight
        className="relative float-right h-6 text-muted-foreground/40 transition-all duration-300 ease-out group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-primary"
        size={18}
      />
      <ContentCard title={title} body={body}>
        <slot />
      </ContentCard>
    </a>
  ) : (
    <div class="relative z-10 flex h-full flex-col">
      <ContentCard title={title} body={body}>
        <slot />
      </ContentCard>
    </div>
  )}
</ShadcnCard>
