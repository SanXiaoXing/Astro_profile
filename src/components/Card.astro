---
import ContentCard from './ContentCard.astro'
import { Card as ShadcnCard } from './ui/card'
import { SquareArrowOutUpRight } from 'lucide-react'

interface Props {
  title?: string
  body?: string
  colSpan?: string
  rowSpan?: string
  href?: string
  colorText?: string
}

const { title, body, colSpan, rowSpan, href, colorText } = Astro.props
---

<ShadcnCard
  className={`card-animate transform-y-[-40%] align-start perspective-1200 group relative col-span-1 h-auto w-full flex-none transform justify-start overflow-hidden p-6 shadow-lg transition-all duration-500 ease-in-out hover:border-primary hover:shadow-[0_0_30px_-7px_hsl(20.5,90.2%,48.2%)] backdrop-blur-sm bg-gradient-to-br from-[hsl(var(--card)/0.8)] to-[hsl(var(--card)/0.4)] ${
    colSpan || 'md:col-span-2'
  } ${rowSpan || ''} ${href ? 'cursor-pointer hover:border-primary' : ''} relative before:pointer-events-none before:absolute before:inset-0 before:rounded-inherit before:bg-gradient-to-br before:from-[hsl(var(--primary)/0.1)] before:to-transparent before:opacity-0 before:transition-opacity before:duration-500 hover:before:opacity-100`}
>
  {href ? (
    <a href={href} class={` h-full w-full ${colorText || ''}`}>
      <SquareArrowOutUpRight
        className="relative h-6 float-right group-hover:text-primary group-hover:translate-x-1 group-hover:-translate-y-1 transition-all ease-in-out duration-300 z-20"
        size={20}
      />
      <ContentCard title={title} body={body}>
        <slot />
      </ContentCard>
    </a>
  ) : (
    <ContentCard title={title} body={body}>
      <slot />
    </ContentCard>
  )}
</ShadcnCard>
