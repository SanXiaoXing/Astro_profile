<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/twikoo@1.6.36/dist/twikoo.css" />
<div class="comments-container">
  <div class="divider"></div>
  <button id="comment-toggle" class="comment-btn">
    <div class="btn-content">
      <svg class="comment-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      <span class="btn-text">展开评论</span>
    </div>
    <span id="comment-count" class="comment-badge hidden"></span>
  </button>
  
  <div class="comments-wrapper" id="comment">
    <div id="twikoo-comments"></div>
  </div>
</div>

<script>
  declare global {
    interface Window {
      twikoo?: {
        init: (options: { envId: string; el: string }) => void;
        getCommentsCount?: (options: { envId: string; urls: string[]; includeReply: boolean }) => Promise<Array<{ count: number }>>;
      };
      getCommentCount?: () => void;
      __twikooScriptLoading?: Promise<void>;
      __commentToggleHandler?: () => void;
      __twikooCurrentPath?: string;
    }
  }

  const TWIKOO_SRC = 'https://cdn.jsdelivr.net/npm/twikoo@1.6.36/dist/twikoo.all.min.js';
  const TWIKOO_ENV = 'https://blog-twikoo.sanxiaoxing.cn/';

  function loadTwikooScript() {
    if (window.twikoo) {
      return Promise.resolve();
    }

    if (window.__twikooScriptLoading) {
      return window.__twikooScriptLoading;
    }

    window.__twikooScriptLoading = new Promise((resolve, reject) => {
      const existing = document.querySelector('script[data-twikoo-loader="true"]') as HTMLScriptElement | null;
      if (existing) {
        if (window.twikoo) {
          resolve();
          return;
        }
        existing.addEventListener('load', () => resolve(), { once: true });
        existing.addEventListener('error', () => reject(new Error('Twikoo 脚本加载失败')), { once: true });
        return;
      }

      const script = document.createElement('script');
      script.src = TWIKOO_SRC;
      script.async = true;
      script.dataset.twikooLoader = 'true';
      script.addEventListener('load', () => resolve(), { once: true });
      script.addEventListener('error', () => reject(new Error('Twikoo 脚本加载失败')), { once: true });
      document.body.appendChild(script);
    });

    return window.__twikooScriptLoading;
  }

  async function initTwikoo() {
    const twikooRoot = document.getElementById('twikoo-comments');
    if (!twikooRoot) {
      return false;
    }

    await loadTwikooScript();
    if (!window.twikoo || typeof window.twikoo.init !== 'function') {
      return false;
    }

    twikooRoot.innerHTML = '';
    window.twikoo.init({
      envId: TWIKOO_ENV,
      el: '#twikoo-comments',
    });
    window.__twikooCurrentPath = window.location.pathname;
    return true;
  }

  window.getCommentCount = function() {
    const currentPath = window.location.pathname;
    const countBadge = document.getElementById('comment-count');
    if (!countBadge) {
      return;
    }

    if (window.twikoo && typeof window.twikoo.getCommentsCount === 'function') {
      window.twikoo.getCommentsCount({
        envId: TWIKOO_ENV,
        urls: [currentPath],
        includeReply: true
      }).then(function (res) {
        if (res.length > 0 && res[0].count > 0) {
          countBadge.textContent = String(res[0].count);
          countBadge.classList.remove('hidden');
          setTimeout(() => {
            countBadge.classList.add('show');
          }, 10);
        } else {
          countBadge.classList.add('hidden');
          countBadge.classList.remove('show');
        }
      }).catch(function (err) {
        console.error('获取评论数量失败:', err);
      });
    }
  };

  function initCommentSection() {
    const commentSection = document.getElementById('comment');
    const commentToggle = document.getElementById('comment-toggle');
    
    if(commentSection) {
      commentSection.style.display = 'none';
      commentSection.style.opacity = '0';
      commentSection.style.transform = 'translateY(-10px)';
    }
    
    if(commentToggle) {
      if (window.__commentToggleHandler) {
        commentToggle.removeEventListener('click', window.__commentToggleHandler);
      }

      const clickHandler = async () => {
        if(commentSection) {
          const isHidden = commentSection.style.display === 'none';
          
          if(isHidden) {
            commentSection.style.display = 'block';
            commentSection.offsetHeight; 
            commentSection.style.opacity = '1';
            commentSection.style.transform = 'translateY(0)';
            
            const text = commentToggle.querySelector('.btn-text');
            if (text) {
              text.textContent = '收起评论';
            }
            commentToggle.classList.add('active');

            const twikooRoot = document.getElementById('twikoo-comments');
            const needInit = !twikooRoot || twikooRoot.childElementCount === 0 || window.__twikooCurrentPath !== window.location.pathname;

            if (needInit) {
              if (text) {
                text.textContent = '评论加载中...';
              }
              await new Promise((resolve) => requestAnimationFrame(() => resolve(undefined)));
              const ok = await initTwikoo();
              if (text) {
                text.textContent = ok ? '收起评论' : '展开评论';
              }
              if (!ok) {
                commentToggle.classList.remove('active');
              }
              setTimeout(() => {
                window.getCommentCount?.();
              }, 500);
            }
          } else {
            commentSection.style.opacity = '0';
            commentSection.style.transform = 'translateY(-10px)';
            
            setTimeout(() => {
              commentSection.style.display = 'none';
            }, 300);
            
            const text = commentToggle.querySelector('.btn-text');
            if (text) {
              text.textContent = '展开评论';
            }
            commentToggle.classList.remove('active');
          }
        }
      };

      commentToggle.addEventListener('click', clickHandler);
      window.__commentToggleHandler = clickHandler;
    }
    
    loadTwikooScript().then(() => {
      setTimeout(() => {
        window.getCommentCount?.();
      }, 500);
    });
  }
  
  document.addEventListener('DOMContentLoaded', initCommentSection);
  
  document.addEventListener('astro:page-load', () => {
    initCommentSection();
    setTimeout(() => {
      if (typeof window.getCommentCount === 'function') {
        window.getCommentCount();
      }
    }, 500);
  });
</script>

<style>
  .comments-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-top: 3rem;
  }

  .divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(133, 133, 168, 0.2), transparent);
    margin-bottom: 2rem;
  }

  .comment-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    background: hsl(var(--card) / 0.6);
    border: 1px solid hsl(var(--primary) / 0.15);
    border-radius: 2rem;
    cursor: pointer;
    transition: all 0.25s ease;
    color: var(--gray);
    font-family: var(--font-family-mono);
    font-size: 0.95rem;
  }

  .btn-content {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    z-index: 1;
  }

  .comment-icon {
    color: var(--hc);
    transition: transform 0.3s ease;
  }

  .comment-btn:hover {
    color: var(--fontc);
    border-color: hsl(var(--primary) / 0.4);
    background: hsl(var(--card) / 0.8);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px hsl(var(--primary) / 0.1);
  }

  .comment-btn:hover .comment-icon {
    transform: scale(1.1) rotate(-5deg);
  }

  .comment-btn.active {
    background: hsl(var(--card) / 0.9);
    border-color: var(--hc);
    color: var(--hc);
    box-shadow: 0 0 20px hsl(var(--primary) / 0.15);
  }

  .comment-btn.active .comment-icon {
    color: var(--orange);
  }

  .comment-badge {
    position: absolute;
    top: -8px;
    right: -8px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    background: var(--orange);
    color: var(--bgc);
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 12px;
    transform: scale(0);
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 2px 8px rgba(255, 179, 0, 0.4);
    z-index: 2;
  }

  .comment-badge.show {
    transform: scale(1);
    opacity: 1;
    animation: bounce-badge 2s infinite;
  }

  .comments-wrapper {
    width: 100%;
    max-width: 800px;
    margin-top: 2rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes bounce-badge {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
      box-shadow: 0 4px 12px rgba(255, 179, 0, 0.6);
    }
  }

  /* 隐藏原始的 hidden 类 */
  .hidden {
    display: none !important;
  }
</style>
