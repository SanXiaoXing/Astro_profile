---
interface Props {
  title: string
  date?: Date
  seed?: number
  class?: string
}

const { title, date, seed = 47, class: className } = Astro.props
const formattedDate =
  date &&
  new Intl.DateTimeFormat('zh-CN', {
    timeZone: 'Asia/Shanghai',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date)
---

<paper-fold
  class:list={['paper-fold', className]}
  data-title={title}
  data-seed={seed}
>
  <button
    class="paper-fold-trigger"
    type="button"
    aria-label={`展开：${title}`}
    aria-haspopup="dialog"
    hidden
  >
    <span class="paper-fold-shadow" aria-hidden="true"></span>
    <canvas class="paper-fold-thumbnail" aria-hidden="true"></canvas>
  </button>
  <details class="paper-fold-fallback">
    <summary>展开纸张</summary>
    <article class="paper-fold-body">
      <header class="paper-fold-meta">
        <h2 class="paper-fold-title">{title}</h2>
        {date && <time datetime={date.toISOString()}>{formattedDate}</time>}
      </header>
      <slot />
    </article>
  </details>
  <dialog class="paper-fold-dialog" aria-label={title}>
    <canvas class="paper-fold-stage" aria-hidden="true"></canvas>
    <div class="paper-fold-reader" hidden></div>
    <button
      class="paper-fold-close"
      type="button"
      aria-label="折回纸团"
      autofocus>×</button
    >
  </dialog>
</paper-fold>

<script>
  import './paper-fold/client.js'
</script>

<style is:global>
  .paper-fold {
    display: block;
    min-width: 0;
  }
  .paper-fold [hidden] {
    display: none !important;
  }
  .paper-fold-trigger {
    position: relative;
    display: grid;
    place-items: center;
    width: 120px;
    height: 120px;
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fontc);
    cursor: zoom-in;
    -webkit-tap-highlight-color: transparent;
  }
  .paper-fold-thumbnail {
    position: relative;
    width: 120px;
    height: 120px;
    z-index: 1;
  }
  .paper-fold-shadow {
    position: absolute;
    top: 80px;
    left: 49px;
    width: 56px;
    height: 19px;
    border-radius: 50%;
    background: #555e47;
    filter: blur(7px);
    opacity: 0.2;
    transform: rotate(-16deg);
    pointer-events: none;
  }
  .paper-fold-meta {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #45534626;
  }
  .paper-fold-body .paper-fold-title {
    margin: 0 0 0.5rem;
    font-size: 1.55em;
  }
  .paper-fold-meta time {
    color: #75806e;
    font-size: 0.8em;
    font-variant-numeric: tabular-nums;
  }
  .paper-fold-trigger:focus-visible,
  .paper-fold-close:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 5px;
    border-radius: 8px;
  }
  .paper-fold-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: transparent;
    color: #455346;
  }
  .paper-fold-dialog::backdrop {
    background: #252d244d;
    backdrop-filter: blur(18px) saturate(0.65);
  }
  .paper-fold-stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    filter: drop-shadow(0 15px 22px #242f2230);
  }
  .paper-fold-reader {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--paper-width);
    height: auto;
    max-height: var(--paper-height);
    transform: translate(-50%, -50%);
    overflow: auto;
    overscroll-behavior: contain;
    background: #f4f0e4;
    color: #455346;
    box-shadow:
      0 15px 40px #242f2230,
      0 2px 5px #242f2220;
    scrollbar-color: #a3aa98 #f4f0e4;
  }
  .paper-fold-reader .paper-fold-body {
    position: relative;
    isolation: isolate;
  }
  .paper-fold-reader .paper-fold-body::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    /* Paired light and dark edges suggest pressed folds, rather than ink lines.
       Keep the texture attached to the paper as long entries scroll. */
    background:
      linear-gradient(
        92deg,
        transparent 45%,
        #685b4010 48.8%,
        #685b4026 49.6%,
        #fffdf5a6 49.9%,
        #fffdf530 50.5%,
        transparent 54%
      ),
      linear-gradient(
        178deg,
        transparent 31%,
        #685b4012 34.2%,
        #685b4021 34.8%,
        #fffdf58c 35.1%,
        transparent 38%
      ),
      linear-gradient(
        183deg,
        transparent 65%,
        #fffdf550 68%,
        #fffdf58c 68.7%,
        #685b401f 69%,
        transparent 72%
      ),
      linear-gradient(
        133deg,
        transparent 17%,
        #685b400c 21.5%,
        #fffdf566 22%,
        transparent 25%,
        transparent 77%,
        #685b4012 80%,
        #fffdf566 80.4%,
        transparent 83%
      );
    box-shadow:
      inset 1px 0 2px #fffdf5b3,
      inset -1px 0 3px #685b4026,
      inset 0 -2px 6px #685b4012;
  }
  .paper-fold-close {
    position: absolute;
    top: max(18px, env(safe-area-inset-top));
    right: max(22px, env(safe-area-inset-right));
    z-index: 2;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid #ffffffa6;
    border-radius: 50%;
    background: #fafbf5e6;
    color: #455346;
    cursor: pointer;
    font: 28px/1 serif;
  }
  .paper-fold-body {
    padding: clamp(20px, 5vw, 38px);
    font-size: 15px;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }
  .paper-fold-body :is(h1, h2, h3, h4, h5, h6) {
    color: inherit;
    font-family: inherit;
    line-height: 1.5;
    margin: 1.4em 0 0.6em;
  }
  .paper-fold-body h1 {
    font-size: 1.8em;
  }
  .paper-fold-body h2 {
    font-size: 1.4em;
  }
  .paper-fold-body h3 {
    font-size: 1.15em;
  }
  .paper-fold-body > :first-child {
    margin-top: 0;
  }
  .paper-fold-body p {
    margin: 0 0 1em;
  }
  .paper-fold-body a {
    color: #376d62;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .paper-fold-body img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.25em auto;
  }
  .paper-fold-body figure {
    margin: 1.25em 0;
  }
  .paper-fold-body figcaption {
    color: #697565;
    font-size: 0.8em;
  }
  .paper-fold-body :is(ul, ol) {
    padding-left: 1.5em;
    margin: 1em 0;
  }
  .paper-fold-body ul {
    list-style: disc;
  }
  .paper-fold-body ol {
    list-style: decimal;
  }
  .paper-fold-body blockquote {
    margin: 1em 0;
    border-left: 2px solid #84947c;
    padding-left: 1em;
    color: #697565;
  }
  .paper-fold-body pre {
    overflow: auto;
    max-width: 100%;
  }
  .paper-fold-body :not(pre) > code {
    background: #45534612;
    border-radius: 3px;
    padding: 0.1em 0.3em;
  }
  .paper-fold-body table {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    max-width: 100%;
    margin: 1em 0;
  }
  .paper-fold-body :is(th, td) {
    border: 1px solid #45534633;
    padding: 0.4em 0.7em;
  }
  .paper-fold-body hr {
    border: 0;
    border-top: 1px solid #45534633;
    margin: 1.5em 0;
  }
  .paper-fold-body .expressive-code {
    margin: 1em 0;
  }
  .paper-fold-fallback summary {
    cursor: pointer;
  }
</style>
