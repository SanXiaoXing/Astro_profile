---
import ThemeToggle from "./ThemeToggle.astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isWithin = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
const blogLinks = [
  { href: "/blog", label: "全部文章" },
  { href: "/growth", label: "成长笔记" },
  { href: "/tags", label: "标签" },
  { href: "/categories", label: "分类" },
];
const blogActive = blogLinks.some(({ href }) => isWithin(href));
---

<header data-desktop-header>
  <nav aria-label="主导航">
    <a class="header-home" href="/" transition:name="site-logo">SanXiaoXing</a>
    <div class="internal-links">
      <details class="nav-dropdown">
        <summary class:list={["nav-item", { active: blogActive }]}>
          博客
          <svg class="chevron" aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <div class="menu-surface" aria-hidden="true"></div>
        <div class="dropdown-panel">
          {blogLinks.map(({ href, label }) => (
            <a href={href} class:list={{ active: isWithin(href) }} aria-current={pathname === href ? "page" : undefined}>{label}</a>
          ))}
          <a href="/rss.xml" data-umami-event="Button-rss">RSS 订阅</a>
        </div>
      </details>
      <details class="nav-dropdown">
        <summary class:list={["nav-item", { active: isWithin("/mastodon") || isWithin("/papers") }]}>
          随记
          <svg class="chevron" aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <div class="menu-surface" aria-hidden="true"></div>
        <div class="dropdown-panel">
          <a href="/mastodon" class:list={{ active: isWithin("/mastodon") }} aria-current={pathname === "/mastodon" ? "page" : undefined}>嘟文</a>
          <a href="/papers" class:list={{ active: isWithin("/papers") }} aria-current={pathname === "/papers" ? "page" : undefined}>纸团</a>
        </div>
      </details>
      <a href="/friends" class:list={["nav-item", { active: isWithin("/friends") }]} aria-current={pathname === "/friends" ? "page" : undefined}>友链</a>
      <div class="theme-toggle-wrapper">
        <a class="travellings-link" href="https://www.travellings.cn/train" target="_blank" rel="noopener noreferrer" aria-label="开往 · 随机探索博客（新窗口打开）" title="开往 · 随机探索博客">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="3" width="14" height="15" rx="4" />
            <path d="M5 10h14M12 3v7M8 18l-2 3M16 18l2 3M7 21h10" />
            <path d="M8.5 14h.01M15.5 14h.01" stroke-width="3" />
          </svg>
        </a>
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>

<script>
  import { animate, spring } from 'motion';

  const dropdowns = () => document.querySelectorAll<HTMLDetailsElement>('[data-desktop-header] details');
  const versions = new WeakMap<HTMLDetailsElement, number>();
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function setOpen(dropdown: HTMLDetailsElement, open: boolean, instant = false) {
    if (!dropdown.open && !open) return;
    if (!instant && dropdown.dataset.expanded === String(open)) return;
    const summary = dropdown.querySelector('summary')!;
    const panel = dropdown.querySelector<HTMLElement>('.dropdown-panel')!;
    const surface = dropdown.querySelector<HTMLElement>('.menu-surface')!;
    const version = (versions.get(dropdown) || 0) + 1;
    versions.set(dropdown, version);
    const wasOpen = dropdown.open;
    dropdown.open = true;
    dropdown.dataset.expanded = String(open);
    summary.setAttribute('aria-expanded', String(open));
    panel.inert = !open;
    const width = summary.offsetWidth;
    const height = summary.offsetHeight;
    if (!wasOpen) {
      Object.assign(surface.style, { width: `${width}px`, height: `${height}px`, borderRadius: '8px', transform: 'translateY(0px)' });
      panel.style.opacity = '0';
    }
    const immediate = instant || reduceMotion.matches;
    // Animate only the absolute background: links never scale and the nav never reflows.
    const shape = animate(surface, {
      width: `${open ? panel.offsetWidth : width}px`,
      height: `${open ? panel.offsetHeight : height}px`,
      transform: `translateY(${open ? panel.offsetTop : 0}px)`,
      borderRadius: open ? '16px' : '8px',
    }, immediate ? { duration: 0 } : { easing: spring({ stiffness: 500, damping: 38, mass: 1 }) });
    animate(panel, { opacity: open ? 1 : 0 }, { duration: immediate ? 0 : open ? 0.18 : 0.12 });
    const finish = () => {
      if (versions.get(dropdown) !== version) return;
      if (!open) dropdown.open = false;
    };
    if (immediate) finish();
    else shape.finished.then(finish).catch(() => {});
  }

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const current = target.closest<HTMLDetailsElement>('[data-desktop-header] details');
    if (current && target.closest('summary')) {
      event.preventDefault();
      setOpen(current, current.dataset.expanded !== 'true', event.detail === 0);
    }
    dropdowns().forEach((dropdown) => {
      if (dropdown !== current || target.closest('a')) setOpen(dropdown, false);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    dropdowns().forEach((dropdown) => {
      if (!dropdown.open) return;
      if (dropdown.contains(document.activeElement)) dropdown.querySelector('summary')?.focus();
      setOpen(dropdown, false, true);
    });
  });

  document.addEventListener('focusin', (event) => {
    dropdowns().forEach((dropdown) => {
      if (event.target instanceof Node && !dropdown.contains(event.target)) setOpen(dropdown, false);
    });
  });

  const resetMenus = () => dropdowns().forEach((dropdown) => setOpen(dropdown, false, true));
  document.addEventListener('astro:before-swap', resetMenus);
  reduceMotion.addEventListener('change', resetMenus);
</script>

<style>
  header {
    --menu-bg: #1c2230;
    --menu-border: rgba(125, 211, 252, 0.24);
    --menu-text: #c5ccda;
    --menu-shadow: 0 18px 44px rgba(0, 0, 0, 0.45);
    z-index: 50;
    position: sticky;
    top: 0;
    padding: 0 1em;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    background: var(--glass-bg);
    border-bottom: 1px solid var(--glass-border);
  }

  :global(html.light) header {
    --menu-bg: #fffefa;
    --menu-border: rgba(3, 105, 161, 0.18);
    --menu-text: #475569;
    --menu-shadow: 0 18px 38px rgba(31, 41, 55, 0.12);
  }

  nav {
    padding: 0.85rem 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .header-home {
    font-family: var(--font-family-base);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--fontc);
    text-decoration: none;
  }

  .header-home:hover { color: var(--hc); }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-item, .dropdown-panel a {
    font-family: var(--font-family-mono);
    font-size: 0.85rem;
    color: var(--gray);
    text-decoration: none;
    border-radius: 8px;
    transition: background-color var(--duration-base) var(--ease-out),
                color var(--duration-base) var(--ease-out);
  }

  .nav-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.6rem 0.8rem;
    min-height: 40px;
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker { display: none; }
  .nav-item:hover, .dropdown-panel a:hover {
    color: var(--fontc);
    background: hsla(210, 80%, 60%, 0.08);
  }

  .active {
    color: var(--hc) !important;
    background: hsla(210, 80%, 60%, 0.12);
    font-weight: 600;
  }

  a:focus-visible, summary:focus-visible {
    outline: 2px solid var(--hc);
    outline-offset: 3px;
  }

  .nav-dropdown { position: relative; }
  .nav-dropdown > summary { position: relative; z-index: 2; }
  .nav-dropdown[open] { z-index: 3; }
  .chevron { flex-shrink: 0; transition: transform 200ms var(--ease-out); }
  details[open]:not([data-expanded="false"]) .chevron { transform: rotate(180deg); }
  details[open] > summary { color: var(--fontc); }

  .dropdown-panel {
    position: absolute;
    top: calc(100% + 0.65rem);
    left: 0;
    width: 160px;
    z-index: 1;
    padding: 0.4rem;
  }

  .menu-surface {
    position: absolute;
    pointer-events: none;
    top: 0;
    left: 0;
    width: 160px;
    height: 100%;
    background: var(--menu-bg);
    border: 1px solid var(--menu-border);
    border-radius: 16px;
    box-shadow: var(--menu-shadow);
  }

  details:not([data-expanded]) .menu-surface { display: none; }

  /* Native details remains usable before the enhancement loads. */
  details:not([data-expanded]) .dropdown-panel {
    background: var(--menu-bg);
    border: 1px solid var(--menu-border);
    border-radius: 12px;
    box-shadow: var(--menu-shadow);
  }

  .dropdown-panel a { display: block; padding: 0.65rem 0.8rem; white-space: nowrap; color: var(--menu-text); }
  .theme-toggle-wrapper { display: flex; align-items: center; gap: 0.4rem; margin-left: 0.6rem; }

  .travellings-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    color: var(--gray);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 10px;
    text-decoration: none;
  }

  .travellings-link:hover { color: var(--hc); border-color: var(--hc); }

  @media (prefers-reduced-motion: reduce) {
    .nav-item, .dropdown-panel a, .chevron { transition: none; }
  }

  @media (max-width: 600px) {
    header { display: none; }
  }
</style>
