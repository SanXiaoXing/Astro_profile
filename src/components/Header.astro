---
import HeaderLink from "./HeaderLink.astro";
import ThemeToggle from "./ThemeToggle.astro";

const homeSlug = `/`;
const blogSlug = `/blog`;
const growthSlug = `/growth`;
const tagSlug = `/tags`;
const cateSlug = `/categories`;
const aboutSlug = `/about`;
const friendSlug = `/friends`;
const rssSlug = `/rss.xml`;

const { pathname } = Astro.url;

const isArticlePage = pathname.startsWith(blogSlug) || pathname.startsWith(tagSlug) || pathname.startsWith(cateSlug) || pathname.startsWith(growthSlug);
---

<header>
  <nav>
    <div class="header-home"><a href={homeSlug}>SanXiaoXing</a></div>
    <div class="internal-links">
      <HeaderLink href={blogSlug}>博客</HeaderLink>
      <HeaderLink href={growthSlug}>成长</HeaderLink>
      <HeaderLink href={tagSlug}>标签</HeaderLink>
      <HeaderLink href={cateSlug}>分类</HeaderLink>
      <HeaderLink href={friendSlug}>友链</HeaderLink>
      <a href={rssSlug} class="icon-link" data-umami-event="Button-rss" aria-label="RSS Feed">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11a9 9 0 0 1 9 9"/>
          <path d="M4 4a16 16 0 0 1 16 16"/>
          <circle cx="5" cy="19" r="1"/>
        </svg>
      </a>
      <div class="theme-toggle-wrapper">
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>

<style>
  header {
    font-size: 1.07rem;
    z-index: 50;
    position: sticky;
    top: 0;
    margin: 0;
    padding: 0 1em;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    background: var(--glass-bg);
    border-bottom: 1px solid var(--glass-border);
  }

  @media only screen and (max-width: 600px) {
    header {
      display: none;
      z-index: 50;
    }
  }

  nav {
    padding: 0.75em 0.5em;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
  }

  .header-home {
    display: flex;
    font-size: 1.35rem;
  }

  .header-home a {
    font-family: var(--font-family-base);
    font-weight: 700;
    color: var(--fontc);
    text-decoration: none;
    transition: color 0.3s ease;
    letter-spacing: -0.5px;
  }

  .header-home a:hover {
    color: var(--hc);
  }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    background: var(--glass-bg);
    padding: 0.3rem 0.4rem;
    border-radius: 12px;
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(8px);
  }

  .internal-links :global(a) {
    font-family: var(--font-family-mono);
    padding: 0.45em 1em;
    color: var(--gray);
    text-decoration: none;
    position: relative;
    transition: all 0.25s ease;
    border-radius: 8px;
    font-size: 0.85rem;
  }

  .internal-links :global(a:hover) {
    color: var(--fontc);
    background: hsla(210, 80%, 60%, 0.08);
  }

  .internal-links :global(a.active) {
    color: var(--hc);
    background: hsla(210, 80%, 60%, 0.12);
    font-weight: 600;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    margin-left: 0.15rem;
    color: var(--gray);
    background: transparent;
    border-radius: 8px;
    transition: all 0.25s ease;
    cursor: pointer;
  }

  .icon-link:hover {
    color: hsl(var(--accent));
    background: hsla(38, 92%, 55%, 0.1);
  }

  .icon-link svg {
    width: 18px;
    height: 18px;
  }

  .theme-toggle-wrapper {
    display: flex;
    align-items: center;
    margin-left: 0.25rem;
    padding-left: 0.25rem;
    border-left: 1px solid hsla(0, 0%, 100%, 0.1);
  }

  html.light .theme-toggle-wrapper {
    border-left-color: rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 720px) {
    .social-links {
      display: none;
    }
  }
</style>